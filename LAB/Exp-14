{id:1,name:'Wireless Headphones',category:'Electronics',condition:'Good',price:1800,description:'Comfortable over-ear headphones, tested and working.',photo:'🎧',seller:'Local Seller',sellerEmail:'seller@demo.com',status:'Available'},
{id:2,name:'Solid Wood Side Table',category:'Furniture',condition:'Very good',price:2400,description:'Sturdy bedside table with a small drawer.',photo:'🪑',seller:'Local Seller',sellerEmail:'seller@demo.com',status:'Available'},
