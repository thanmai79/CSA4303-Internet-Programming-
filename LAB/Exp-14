const save=()=>localStorage.setItem(KEY,JSON.stringify(db)),me=()=>db.users.find(u=>u.email===sessionStorage.getItem(UK)),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function toast(s,b=false){let x=document.querySelector('#msg');x.textContent=s;x.className='msg'+(b?' bad':'');x.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>x.style.display='none',3000)}function go(p){page=p;render();scrollTo(0,0)}function inp(n,l,t='text',a='required'){return `<label>${l}</label><input name="${n}" type="${t}" ${a}>`}function form(title,id,fields,extra=''){return `<section class="panel field"><h2>${title}</h2><form id="${id}">${fields}<button class="btn">Submit</button></form>${extra}</section>`}
function card(i){return `<article class="card"><div class="photo">${esc(i.photo||'♻️')}</div><h3>${esc(i.name)}</h3><span class="tag">${esc(i.category)}</span><span class="tag">${esc(i.condition)}</span><p>${esc(i.description)}</p><p class="muted">Seller: ${esc(i.seller)} · ${i.status==='Available'?'Available':esc(i.status)}</p><p><b>₹${i.price}</b></p><button class="btn" data-act="buy" data-id="${i.id}">Contact / Order</button><button class="btn gray" data-act="fav" data-id="${i.id}">${favorites.includes(i.id)?'♥ Saved':'♡ Favorite'}</button></article>`}
function render(){let u=me(),links=[['home','Browse'],['favorites','Favorites'],['orders',u&&u.role==='seller'?'My sales':'My transactions']];if(u?.role==='seller')links.push(['listing','Create listing']);if(u?.role==='admin')links.push(['admin','Admin']);if(!u)links.push(['login','Login'],['register','Register']);else links.push(['profile','My account'],['logout','Logout']);document.querySelector('#nav').innerHTML=links.map(([p,t])=>`<a href="#" data-page="${p}" class="${page===p?'on':''}">${t}</a>`).join('');let html='';
if(page==='home'){let cats=db.categories.filter(c=>db.items.some(i=>i.category===c)).concat(db.categories.filter(c=>!db.items.some(i=>i.category===c)));html=`<section class="hero"><h1>Pre-loved, ready for more ♻️</h1><p>Find something useful. Sell what you no longer need. Keep good things in use.</p><form id="search"><div class="grid"><input name="q" placeholder="Search listings"><select name="category"><option value="">All categories</option>${db.categories.map(c=>`<option>${esc(c)}</option>`).join('')}</select><select name="condition"><option value="">Any condition</option><option>Like new</option><option>Very good</option><option>Good</option><option>Fair</option></select><input name="max" type="number" placeholder="Max price ₹"><button class="btn">Search</button></div></form><p>${cats.map(c=>`<a class="tag" href="#${encodeURIComponent(c)}">${esc(c)}</a>`).join('')}</p></section>`+cats.map(c=>`<section class="panel" id="${encodeURIComponent(c)}"><h2>${esc(c)}</h2><div class="grid">${db.items.filter(i=>i.category===c).map(card).join('')||'<p class="muted">No listings in this category yet.</p>'}</div></section>`).join('')}
if(page==='login')html=form('Login','login',`<label>Login as</label><select name="role"><option value="customer">Buyer</option><option value="seller">Seller</option><option value="admin">Administrator</option></select>`+inp('email','Email','email')+inp('password','Password','password'),`<p class="muted">New to ReNewMarket? <a href="#" data-page="register">Create an account</a><br>Demo admin: admin@renewmarket.com / admin123</p>`);
if(page==='register')html=form('Create your account','register',inp('name','Full name')+inp('email','Email','email')+inp('phone','Phone','tel')+`<label>Account type</label><select name="role"><option value="customer">Buyer</option><option value="seller">Seller</option></select>`+inp('password','Password (minimum 6 characters)','password','minlength="6" required'),`<p class="muted">Already registered? <a href="#" data-page="login">Login</a></p>`);
if(page==='listing')html=me()?.role==='seller'?form('Create a listing','listing',inp('name','Item name')+`<label>Category</label><select name="category">${db.categories.map(c=>`<option>${esc(c)}</option>`).join('')}</select><label>Condition</label><select name="condition"><option>Like new</option><option>Very good</option><option>Good</option><option>Fair</option></select>`+inp('price','Price (₹)','number','min="1" required')+inp('photo','Photo emoji (optional)','text','maxlength="8"')+`<label>Description</label><textarea name="description" required></textarea>`):'<section class="panel"><h2>Seller access required</h2><p>Login with a seller account to create a listing.</p></section>';
if(page==='favorites')html=`<section class="panel"><h2>Favorite items</h2><div class="grid">${db.items.filter(i=>favorites.includes(i.id)).map(card).join('')||'<p>No saved listings yet.</p>'}</div></section>`;
if(page==='orders'){let u=me();html=`<section class="panel"><h2>${u?.role==='seller'?'My sales':'My transactions'}</h2><div class="scroll"><table><tr><th>Order</th><th>Item</th><th>Buyer / Seller</th><th>Logistics status</th><th>Feedback</th><th></th></tr>${db.orders.filter(o=>!u||u.role==='admin'||(u.role==='seller'?o.sellerEmail===u.email:o.buyerEmail===u.email)).map(o=>`<tr><td>${o.id}</td><td>${esc(o.itemName)}<br>₹${o.price}</td><td>${esc(o.buyerName)}<br>${esc(o.buyerEmail)}<br>${esc(o.buyerPhone)}</td><td><span class="tag">${esc(o.status)}</span></td><td>${esc(o.feedback||'—')}</td><td>${u?.role==='seller'?`<button class="btn small" data-act="status" data-id="${o.id}">${o.status==='Shipped'?'Mark Received':'Mark Shipped'}</button>`:''}</td></tr>`).join('')||'<tr><td colspan="6">No transactions yet.</td></tr>'}</table></div></section>`}
if(page==='profile'){let u=me();html=u?form('Edit account information','profile',inp('name','Full name','text',`required value="${esc(u.name)}"`)+inp('phone','Phone','tel',`required value="${esc(u.phone)}"`)+inp('password','New password (leave blank to keep)','password','minlength="6"')):''}
if(page==='admin'&&me()?.role==='admin')html=`<section class="panel"><h2>Administrator</h2><div class="tabs"><button data-tab="items" class="${tab==='items'?'on':''}">Commodities</button><button data-tab="categories" class="${tab==='categories'?'on':''}">Categories</button><button data-tab="users" class="${tab==='users'?'on':''}">Users</button><button data-tab="orders" class="${tab==='orders'?'on':''}">Orders</button></div>`+(tab==='items'?`<h3>Add a commodity</h3><form id="newitem" class="grid">${inp('name','Item name')}<label>Category<select name="category">${db.categories.map(c=>`<option>${esc(c)}</option>`).join('')}</select></label>${inp('condition','Condition')}${inp('price','Price (₹)','number','min="1" required')}${inp('photo','Photo emoji') }<label>Description<textarea name="description" required></textarea></label><button class="btn">Add commodity</button></form><div class="scroll"><table><tr><th>Commodity</th><th>Category</th><th>Condition</th><th>Price</th><th>Actions</th></tr>${db.items.map(i=>`<tr><td>${esc(i.name)}</td><td>${esc(i.category)}</td><td>${esc(i.condition)}</td><td><input style="width:100px" type="number" value="${i.price}" data-price="${i.id}"></td><td><button class="btn small" data-act="edit" data-id="${i.id}">Edit</button><button class="btn red small" data-act="deleteitem" data-id="${i.id}">Delete</button></td></tr>`).join('')}</table></div>`:tab==='categories'?`<form id="newcat">${inp('category','New category')}<button class="btn">Add category</button></form><ul>${db.categories.map(c=>`<li>${esc(c)} <button class="btn red small" data-act="deletecat" data-id="${encodeURIComponent(c)}">Delete</button></li>`).join('')}</ul>`:tab==='users'?`<div class="scroll"><table><tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th></th></tr>${db.users.filter(u=>u.role!=='admin').map(u=>`<tr><td>${esc(u.name)}</td><td>${esc(u.email)}</td><td>${esc(u.phone)}</td><td>${u.role}</td><td><button class="btn small" data-act="edituser" data-id="${encodeURIComponent(u.email)}">Edit</button><button class="btn red small" data-act="deleteuser" data-id="${encodeURIComponent(u.email)}">Delete</button></td></tr>`).join('')}</table></div>`:`<div class="scroll"><table><tr><th>Order</th><th>Commodity</th><th>Buyer</th><th>Seller</th><th>Status</th><th></th></tr>${db.orders.map(o=>`<tr><td>${o.id}</td><td>${esc(o.itemName)}</td><td>${esc(o.buyerName)} · ${esc(o.buyerEmail)}</td><td>${esc(o.sellerEmail)}</td><td><select data-status="${o.id}">${['Pending','Shipped','Received'].map(s=>`<option ${s===o.status?'selected':''}>${s}</option>`).join('')}</select></td><td><button class="btn red small" data-act="deleteorder" data-id="${o.id}">Delete</button></td></tr>`).join('')||'<tr><td colspan="6">No orders.</td></tr>'}</table></div>`)+`</section>`;
document.querySelector('#app').innerHTML=html||''}
document.addEventListener('click',e=>{let p=e.target.closest('[data-page]'),t=e.target.closest('[data-tab]'),a=e.target.closest('[data-act]');if(p){e.preventDefault();go(p.dataset.page);return}if(t){tab=t.dataset.tab;render();return}if(!a)return;let id=Number(a.dataset.id),i=db.items.find(x=>x.id===id),u=me();switch(a.dataset.act){case'buy':if(!u){toast('Login to contact a seller or order.',true);return go('login')}if(!i||i.status!=='Available')return toast('This listing is no longer available.',true);if(!confirm('Place a demo order for '+i.name+' at ₹'+i.price+'?'))return;db.orders.push({id:'RM'+Date.now().toString().slice(-7),itemId:i.id,itemName:i.name,price:i.price,buyerEmail:u.email,buyerName:u.name,buyerPhone:u.phone,sellerEmail:i.sellerEmail||'seller@demo.com',status:'Pending',feedback:''});i.status='Pending';save();toast('Order placed. Contact the seller to arrange pickup or delivery.');go('orders');break;case'fav':favorites.includes(id)?favorites=favorites.filter(x=>x!==id):favorites.push(id);localStorage.setItem('renewFavorites',JSON.stringify(favorites));render();break;case'status':{let o=db.orders.find(x=>x.id===a.dataset.id);o.status=o.status==='Shipped'?'Received':'Shipped';let it=db.items.find(x=>x.id===o.itemId);if(it&&o.status==='Received')it.status='Sold';save();render();break}case'deleteitem':db.items=db.items.filter(x=>x.id!==id);save();render();break;case'deletecat':db.categories=db.categories.filter(c=>c!==decodeURIComponent(a.dataset.id));save();render();break;case'deleteuser':{let email=decodeURIComponent(a.dataset.id);db.users=db.users.filter(x=>x.email!==email);save();render();break}case'edituser':{let email=decodeURIComponent(a.dataset.id),x=db.users.find(x=>x.email===email),name=prompt('Update customer name:',x.name),phone=name===null?null:prompt('Update phone:',x.phone);if(name!==null&&phone!==null){x.name=name;x.phone=phone;save();render()}break}case'edit':{let name=prompt('Item name:',i.name);if(name===null)return;let price=prompt('Price:',i.price),description=prompt('Description:',i.description);i.name=name;if(price!==null)i.price=Number(price)||i.price;if(description!==null)i.description=description;save();render();break}case'deleteorder':db.orders=db.orders.filter(o=>o.id!==a.dataset.id);save();render();break;case'logout':sessionStorage.removeItem(UK);go('home')}});
document.addEventListener('change',e=>{if(e.target.dataset.price){let i=db.items.find(x=>x.id===Number(e.target.dataset.price));i.price=Math.max(1,Number(e.target.value)||i.price);save();toast('Price updated')}if(e.target.dataset.status){let o=db.orders.find(x=>x.id===e.target.dataset.status);o.status=e.target.value;if(o.status==='Received'){let i=db.items.find(x=>x.id===o.itemId);if(i)i.status='Sold'}save();toast('Logistics status updated')}});
document.addEventListener('submit',e=>{e.preventDefault();let f=e.target,d=new FormData(f);if(f.id==='search'){let q=String(d.get('q')||'').toLowerCase(),c=String(d.get('category')||''),cond=String(d.get('condition')||''),max=Number(d.get('max'))||Infinity;document.querySelectorAll('.card').forEach(el=>{let i=db.items.find(x=>x.name===el.querySelector('h3')?.textContent);el.style.display=i&&i.name.toLowerCase().includes(q)&&(!c||i.category===c)&&(!cond||i.condition===cond)&&i.price<=max?'':'none'})}if(f.id==='register'){let email=String(d.get('email')).trim().toLowerCase();if(db.users.some(x=>x.email===email))return toast('Email already registered.',true);db.users.push({name:String(d.get('name')).trim(),email,phone:String(d.get('phone')).trim(),password:d.get('password'),role:d.get('role')});save();toast('Account created. Please login.');go('login')}if(f.id==='login'){let u=db.users.find(x=>x.email===String(d.get('email')).trim().toLowerCase());if(!u||u.password!==d.get('password'))return toast('Incorrect email or password.',true);if(u.role!==d.get('role'))return toast('Choose the correct account type.',true);sessionStorage.setItem(UK,u.email);toast('Welcome, '+u.name);go(u.role==='admin'?'admin':'home')}if(f.id==='listing'){let u=me();db.items.push({id:db.next++,name:String(d.get('name')),category:String(d.get('category')),condition:String(d.get('condition')),price:Number(d.get('price')),description:String(d.get('description')),photo:String(d.get('photo')||'♻️'),seller:u.name,sellerEmail:u.email,status:'Available'});save();toast('Your listing is live.');go('home')}if(f.id==='newitem'){db.items.push({id:db.next++,name:String(d.get('name')),category:String(d.get('category')),condition:String(d.get('condition')),price:Number(d.get('price')),description:String(d.get('description')),photo:String(d.get('photo')||'♻️'),seller:'ReNewMarket',sellerEmail:'admin@renewmarket.com',status:'Available'});save();toast('Commodity added.');render()}if(f.id==='newcat'){let c=String(d.get('category')).trim();if(db.categories.includes(c))return toast('Category already exists.',true);db.categories.push(c);save();render()}if(f.id==='profile'){let u=me();u.name=String(d.get('name'));u.phone=String(d.get('phone'));if(d.get('password'))u.password=d.get('password');save();toast('Account updated.');render()}});
document.addEventListener('click',e=>{let a=e.target.closest('[data-act="logout"]');if(a){e.preventDefault();sessionStorage.removeItem(UK);toast('Logged out');go('home')}});save();render();
</script>
</body></html>
