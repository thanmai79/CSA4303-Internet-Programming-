<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>BlossomGifts | Flowers & thoughtful gifts</title>
<style>
*{box-sizing:border-box;margin:0;padding:0} :root{--pink:#c53d70;--deep:#702345;--pale:#fff3f7;--line:#f0d4df;--green:#287c55;--red:#b3261e}
body{font-family:Arial,sans-serif;background:#fff9fb;color:#30252a;line-height:1.55}header{background:var(--deep);color:white;position:sticky;top:0;z-index:3}.bar{max-width:1100px;margin:auto;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.brand{font-weight:bold;font-size:23px;color:#fff;text-decoration:none}nav{display:flex;gap:6px;flex-wrap:wrap}nav a{color:white;text-decoration:none;padding:7px 10px;border-radius:5px;font-size:14px}nav a:hover,nav a.on{background:var(--pink)}main{max-width:1100px;margin:22px auto;padding:0 16px;min-height:72vh}.hero{padding:34px 20px;background:linear-gradient(135deg,#702345,#d25283);color:white;border-radius:12px;text-align:center;margin-bottom:20px}.hero h1{font-size:32px;margin-bottom:6px}.panel{background:white;border:1px solid var(--line);border-radius:10px;padding:18px;margin-bottom:18px}.panel h2{color:var(--deep);font-size:21px;border-bottom:2px solid var(--pink);padding-bottom:6px;margin-bottom:13px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}.card{border:1px solid var(--line);border-radius:9px;padding:14px;background:#fff}.card h3{color:var(--deep)}.photo{height:130px;border-radius:7px;background:linear-gradient(135deg,#ffe1eb,#f5b7cb);display:grid;place-items:center;font-size:54px;margin-bottom:10px}.muted{color:#74666c;font-size:13px}.tag{display:inline-block;background:#fce5ed;color:var(--deep);border-radius:20px;padding:2px 9px;font-size:12px;margin:3px 3px 3px 0}.btn{display:inline-block;border:0;border-radius:6px;background:var(--pink);color:white;padding:9px 14px;cursor:pointer;text-decoration:none;margin:8px 5px 0 0;font-size:14px}.btn:hover{background:var(--deep)}.btn.gray{background:#776c70}.btn.red{background:var(--red)}.btn.small{font-size:12px;padding:5px 9px}.field{max-width:500px}label{display:block;font-weight:bold;font-size:13px;margin:10px 0 3px}input,select,textarea{width:100%;padding:9px;border:1px solid #d7c5cc;border-radius:5px;font:inherit}table{width:100%;border-collapse:collapse;font-size:14px}th,td{padding:8px;border:1px solid var(--line);text-align:left}th{background:var(--pale)}.scroll{overflow:auto}.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}.tabs button{border:0;border-radius:5px;padding:8px 12px;background:#fce5ed;cursor:pointer}.tabs .on{background:var(--pink);color:white}.msg{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:var(--green);color:white;padding:10px 16px;border-radius:7px;display:none;z-index:6;max-width:90%}.msg.bad{background:var(--red)}footer{text-align:center;background:var(--deep);color:white;padding:14px;font-size:13px}@media(max-width:650px){.hero h1{font-size:25px}nav{width:100%}}
</style>
</head>
<body><header><div class="bar"><a href="#" class="brand" data-page="home">🌷 BlossomGifts</a><nav id="nav"></nav></div></header><main id="app"></main><footer>BlossomGifts · Thoughtful flowers and gifts for every occasion</footer><div class="msg" id="msg"></div>
<script>
// Browser-only classroom demo. Do not enter real payment or personal information.
const DBKEY='blossomGiftsDB', USERKEY='blossomGiftsUser';
const initial=()=>({users:[{name:'Blossom Administrator',email:'admin@blossom.com',phone:'',password:'admin123',role:'admin'}],items:[
 {id:1,name:'Classic Rose Bouquet',category:'Flowers',sub:'Roses',occasion:'Anniversary',price:1499,stock:12,description:'A hand-tied dozen red roses with fresh greenery.'},
 {id:2,name:'Sunny Day Bouquet',category:'Flowers',sub:'Mixed flowers',occasion:'Birthday',price:1199,stock:9,description:'Bright seasonal blooms arranged with care.'},
 {id:3,name:'Orchid Elegance',category:'Flowers',sub:'Orchids',occasion:'Thank You',price:1899,stock:5,description:'Long-lasting orchids in a keepsake ceramic pot.'},
 {id:4,name:'Sweet Treat Basket',category:'Gift Baskets',sub:'Gourmet',occasion:'Birthday',price:1599,stock:8,description:'A basket of chocolates, cookies and small delights.'},
 {id:5,name:'Cozy Care Box',category:'Personalized Gifts',sub:'Care packages',occasion:'Get Well',price:1299,stock:6,description:'A comforting gift box with tea, treats and a greeting card.'},
 {id:6,name:'Custom Name Mug',category:'Personalized Gifts',sub:'Personalized keepsakes',occasion:'Just Because',price:699,stock:15,description:'A ceramic mug personalized with the recipient’s name.'}],orders:[],next:7});
let db;try{db=JSON.parse(localStorage.getItem(DBKEY))}catch{}if(!db||!db.items)db=initial();
let page='home',cart=JSON.parse(sessionStorage.getItem('blossomCart')||'[]'),adminTab='items';
const save=()=>localStorage.setItem(DBKEY,JSON.stringify(db)), me=()=>db.users.find(u=>u.email===sessionStorage.getItem(USERKEY));
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function toast(t,bad=false){let m=document.querySelector('#msg');m.textContent=t;m.className='msg'+(bad?' bad':'');m.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>m.style.display='none',3200)}
function go(p){page=p;render();scrollTo(0,0)}
function form(title,id,fields,extra=''){return `<section class="panel field"><h2>${title}</h2><form id="${id}">${fields}<button class="btn">Submit</button></form>${extra}</section>`}
function input(n,label,type='text',attrs='required'){return `<label>${label}</label><input name="${n}" type="${type}" ${attrs}>`}
function productCard(i){return `<article class="card"><div class="photo">${i.category==='Flowers'?'💐':i.category==='Gift Baskets'?'🧺':'🎁'}</div><h3>${esc(i.name)}</h3><span class="tag">${esc(i.category)}</span><span class="tag">${esc(i.sub)}</span><p class="muted">${esc(i.occasion)} · ${i.stock} available</p><p>${esc(i.description)}</p><p><b>₹${i.price}</b></p><button class="btn" data-action="add" data-id="${i.id}">Add to cart</button><button class="btn gray" data-action="details" data-id="${i.id}">Details</button></article>`}
function render(){let u=me();let links=[['home','Shop'],['cart',`Cart (${cart.reduce((a,x)=>a+x.qty,0)})`]];if(u)links.push(['orders','My orders'],['profile','My details']);if(u?.role==='admin')links.push(['admin','Admin']);if(!u)links.push(['login','Login'],['register','Register']);else links.push(['logout','Logout']);document.querySelector('#nav').innerHTML=links.map(([p,t])=>`<a href="#" data-page="${p}" class="${page===p?'on':''}">${t}</a>`).join('');
let html='';if(page==='home'){let cats=[...new Set(db.items.map(i=>i.category))];html=`<section class="hero"><h1>Send a little happiness 🌷</h1><p>Beautiful flowers and thoughtful gifts, delivered with care.</p><p>${cats.map(c=>`<a class="tag" href="#${encodeURIComponent(c)}">${esc(c)}</a>`).join('')}</p><form id="search"><input name="q" placeholder="Search flowers, gifts or occasions"><button class="btn">Search</button></form></section>`+cats.map(c=>`<section class="panel" id="${encodeURIComponent(c)}"><h2>${esc(c)}</h2><p>${[...new Set(db.items.filter(i=>i.category===c).map(i=>i.sub))].map(s=>`<span class="tag">${esc(s)}</span>`).join('')}</p><div class="grid">${db.items.filter(i=>i.category===c).map(productCard).join('')||'<p>Coming soon.</p>'}</div></section>`).join('')}
if(page==='login')html=form('Login','login',`<label>Login as</label><select name="role"><option value="customer">Customer</option><option value="admin">Administrator</option></select>`+input('email','Email','email')+input('password','Password','password'),`<p class="muted">New to BlossomGifts? <a href="#" data-page="register">Create an account</a><br>Demo admin: admin@blossom.com / admin123</p>`);
if(page==='register')html=form('Create your customer account','register',input('name','Full name')+input('email','Email','email')+input('phone','Phone','tel')+input('password','Password (minimum 6 characters)','password','minlength="6" required'),`<p class="muted">Already registered? <a href="#" data-page="login">Login</a></p>`);
if(page==='cart'){html=`<section class="panel"><h2>Shopping Cart</h2><div class="scroll"><table><tr><th>Item</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th></th></tr>${cart.map(x=>{let i=db.items.find(z=>z.id===x.id);return i?`<tr><td>${esc(i.name)}</td><td>₹${i.price}</td><td><input style="width:75px" type="number" min="1" max="${i.stock}" value="${x.qty}" data-qty="${i.id}"></td><td>₹${i.price*x.qty}</td><td><button class="btn red small" data-action="remove" data-id="${i.id}">Remove</button></td></tr>`:''}).join('')||'<tr><td colspan="5">Your cart is empty.</td></tr>'}</table></div><h3>Total: ₹${cart.reduce((n,x)=>n+(db.items.find(i=>i.id===x.id)?.price||0)*x.qty,0)}</h3>${cart.length?`<button class="btn" data-action="checkout">Checkout</button>`:''}</section>`}
if(page==='checkout')html=`<section class="panel field"><h2>Delivery and checkout</h2><p class="muted">Demo checkout only. No real payment is collected.</p><form id="checkout">${input('address','Delivery address')}${input('date','Delivery date','date','required min="'+new Date().toISOString().slice(0,10)+'"')}<label>Delivery time</label><select name="time"><option>9 AM–12 PM</option><option>12 PM–3 PM</option><option>3 PM–6 PM</option><option>6 PM–9 PM</option></select><label>Gift message (optional)</label><textarea name="note" rows="3"></textarea><label>Demo payment method</label><select name="payment"><option>Pay on delivery (demo)</option><option>Card (demo only)</option></select><button class="btn">Place order</button></form></section>`;
if(page==='orders'){if(!u)page='login';else html=`<section class="panel"><h2>Order history and status</h2><div class="scroll"><table><tr><th>Order</th><th>Items</th><th>Delivery</th><th>Total</th><th>Status</th></tr>${db.orders.filter(o=>o.email===u.email).map(o=>`<tr><td>${o.id}</td><td>${o.items.map(x=>esc(x.name)+' × '+x.qty).join('<br>')}</td><td>${esc(o.date)}<br>${esc(o.time)}<br>${esc(o.address)}</td><td>₹${o.total}</td><td><span class="tag">${esc(o.status)}</span></td></tr>`).join('')||'<tr><td colspan="5">No orders yet.</td></tr>'}</table></div></section>`}
if(page==='profile')html=u?form('My customer details','profile',input('name','Full name','text',`required value="${esc(u.name)}"`)+input('phone','Phone','tel',`required value="${esc(u.phone)}"`)+input('password','New password (leave blank to keep)','password','minlength="6"')):'';
if(page==='admin'&&u?.role==='admin')html=`<section class="panel"><h2>Administrator</h2><div class="tabs"><button data-tab="items" class="${adminTab==='items'?'on':''}">Inventory</button><button data-tab="orders" class="${adminTab==='orders'?'on':''}">Orders & customers</button></div>${adminTab==='items'?`<h3>Add an item</h3><form id="newitem" class="grid">${input('name','Item name')}${input('category','Category')}${input('sub','Subcategory')}${input('occasion','Occasion')}${input('price','Price (₹)','number','required min="1"')}${input('stock','Available quantity','number','required min="0"')}<div style="grid-column:1/-1">${input('description','Description')}</div><button class="btn">Add item</button></form><div class="scroll"><table><tr><th>Item</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr>${db.items.map(i=>`<tr><td>${esc(i.name)}</td><td>${esc(i.category)} / ${esc(i.sub)}</td><td><input style="width:95px" type="number" value="${i.price}" data-price="${i.id}"></td><td>${i.stock}</td><td><button class="btn red small" data-action="delete" data-id="${i.id}">Delete</button></td></tr>`).join('')}</table></div>`:`<div class="scroll"><table><tr><th>Order</th><th>Customer</th><th>Phone</th><th>Delivery</th><th>Total</th><th>Status</th></tr>${db.orders.map(o=>`<tr><td>${o.id}<br>${o.items.map(x=>esc(x.name)+' × '+x.qty).join('<br>')}</td><td>${esc(o.name)}<br>${esc(o.email)}</td><td>${esc(o.phone)}</td><td>${esc(o.date)} ${esc(o.time)}<br>${esc(o.address)}</td><td>₹${o.total}</td><td><select data-status="${o.id}">${['Confirmed','Preparing','Out for delivery','Delivered','Cancelled'].map(s=>`<option ${s===o.status?'selected':''}>${s}</option>`).join('')}</select></td></tr>`).join('')||'<tr><td colspan="6">No orders yet.</td></tr>'}</table></div>`}</section>`;
document.querySelector('#app').innerHTML=html||''}
function persistCart(){sessionStorage.setItem('blossomCart',JSON.stringify(cart))}
document.addEventListener('click',e=>{let p=e.target.closest('[data-page]'),a=e.target.closest('[data-action]'),t=e.target.closest('[data-tab]');if(p){e.preventDefault();go(p.dataset.page);return}if(t){adminTab=t.dataset.tab;render();return}if(!a)return;let id=Number(a.dataset.id),item=db.items.find(i=>i.id===id);if(a.dataset.action==='add'){if(!me()){toast('Please login to add items to your cart.',true);return go('login')}if(me().role!=='customer'){toast('Use a customer account to shop.',true);return}let x=cart.find(c=>c.id===id);if(x)x.qty=Math.min(item.stock,x.qty+1);else cart.push({id,qty:1});persistCart();toast('Added to your cart.');render()}if(a.dataset.action==='remove'){cart=cart.filter(x=>x.id!==id);persistCart();render()}if(a.dataset.action==='details')toast(item.name+': '+item.description+' · ₹'+item.price);if(a.dataset.action==='checkout'){if(!me())return go('login');go('checkout')}if(a.dataset.action==='delete'){db.items=db.items.filter(i=>i.id!==id);save();render()}if(a.dataset.action==='logout'){sessionStorage.removeItem(USERKEY);toast('Logged out.');go('home')}});
document.addEventListener('change',e=>{if(e.target.dataset.qty){let x=cart.find(z=>z.id===Number(e.target.dataset.qty)),i=db.items.find(z=>z.id===x.id);x.qty=Math.max(1,Math.min(i.stock,Number(e.target.value)||1));persistCart();render()}if(e.target.dataset.price){let i=db.items.find(z=>z.id===Number(e.target.dataset.price));i.price=Math.max(1,Number(e.target.value)||i.price);save();toast('Price updated.')}if(e.target.dataset.status){let o=db.orders.find(z=>z.id===e.target.dataset.status);o.status=e.target.value;save();toast('Order status updated.')}});
document.addEventListener('submit',e=>{e.preventDefault();let f=e.target,d=new FormData(f);if(f.id==='search'){let q=String(d.get('q')||'').toLowerCase();document.querySelectorAll('.card').forEach(c=>c.style.display=c.textContent.toLowerCase().includes(q)?'':'none')}if(f.id==='register'){let email=String(d.get('email')).trim().toLowerCase();if(db.users.some(u=>u.email===email))return toast('That email is already registered.',true);db.users.push({name:String(d.get('name')).trim(),email,phone:String(d.get('phone')).trim(),password:d.get('password'),role:'customer'});save();toast('Account created. Please login.');go('login')}if(f.id==='login'){let u=db.users.find(x=>x.email===String(d.get('email')).trim().toLowerCase());if(!u||u.password!==d.get('password'))return toast('Email or password is incorrect.',true);if(u.role!==d.get('role'))return toast('Choose the correct account type.',true);sessionStorage.setItem(USERKEY,u.email);toast('Welcome, '+u.name+'!');go(u.role==='admin'?'admin':'home')}if(f.id==='profile'){let u=me();u.name=String(d.get('name')).trim();u.phone=String(d.get('phone')).trim();if(d.get('password'))u.password=d.get('password');save();toast('Details updated.');render()}if(f.id==='checkout'){let u=me(),items=cart.map(x=>({...db.items.find(i=>i.id===x.id),qty:x.qty}));if(items.some(i=>!i||i.stock<i.qty))return toast('An item is no longer available in that quantity.',true);items.forEach(i=>db.items.find(z=>z.id===i.id).stock-=i.qty);db.orders.push({id:'BG'+Date.now().toString().slice(-7),email:u.email,name:u.name,phone:u.phone,address:String(d.get('address')),date:String(d.get('date')),time:String(d.get('time')),note:String(d.get('note')||''),items:items.map(i=>({name:i.name,qty:i.qty})),total:items.reduce((n,i)=>n+i.price*i.qty,0),status:'Confirmed'});cart=[];persistCart();save();toast('Order confirmed!');go('orders')}if(f.id==='newitem'){if(!me()||me().role!=='admin')return;db.items.push({id:db.next++,name:String(d.get('name')),category:String(d.get('category')),sub:String(d.get('sub')),occasion:String(d.get('occasion')),price:Number(d.get('price')),stock:Number(d.get('stock')),description:String(d.get('description'))});save();toast('Item added.');render()}});
document.addEventListener('click',e=>{if(e.target.matches('[data-action="logout"]')){e.preventDefault();sessionStorage.removeItem(USERKEY);go('home')}});
save();render();
</script></body></html>
