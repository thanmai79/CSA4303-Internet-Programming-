<body>
<header>
<div class="logo" onclick="home()">🌱 Agri<span>Mart</span></div>
<div class="header-buttons">
<button onclick="cartPage()">🛒 Cart (<span id="cartCount">0</span>)</button>
<button onclick="auth('login')">Login</button>
<button onclick="auth('register')">Register</button>
</div>
</header>

<nav>
<a onclick="home()">Home</a>
<a onclick="productsPage()">Products</a>
<a onclick="cartPage()">My Cart</a>
<a onclick="ordersPage()">My Orders</a>
<a onclick="auth('farmer')">Farmer Portal</a>
<a onclick="dashboard()">My Account</a>
<a id="logoutLink" class="hidden" onclick="logout()">Logout</a>
</nav>

<main id="app"></main>

<footer>
<div>
<h2>🌱 AgriMart</h2>
<p>Connecting farmers and customers.</p>
<p>Fresh products directly from the farm to your home.</p>
<p>© 2026 AgriMart | Internet Programming Project</p>
</div>
</footer>

<div id="modal"></div>

<script>
const app=document.getElementById("app");

const initialProducts=[
{id:1,name:"Fresh Tomatoes",category:"Vegetables",price:30,unit:"kg",stock:100,farmer:"Ravi Kumar",emoji:"🍅",description:"Fresh farm-grown red tomatoes."},
{id:2,name:"Organic Potatoes",category:"Vegetables",price:35,unit:"kg",stock:80,farmer:"Lakshmi Farms",emoji:"🥔",description:"Quality potatoes harvested locally."},
{id:3,name:"Fresh Carrots",category:"Vegetables",price:45,unit:"kg",stock:60,farmer:"Ravi Kumar",emoji:"🥕",description:"Fresh and crunchy carrots."},
{id:4,name:"Farm Rice",category:"Grains",price:55,unit:"kg",stock:200,farmer:"Green Valley Farm",emoji:"🌾",description:"Quality rice directly from farmers."},
{id:5,name:"Fresh Apples",category:"Fruits",price:120,unit:"kg",stock:45,farmer:"Hill Farm",emoji:"🍎",description:"Sweet and fresh apples."},
{id:6,name:"Bananas",category:"Fruits",price:50,unit:"dozen",stock:70,farmer:"Lakshmi Farms",emoji:"🍌",description:"Naturally ripened bananas."},
{id:7,name:"Fresh Spinach",category:"Vegetables",price:25,unit:"bunch",stock:50,farmer:"Ravi Kumar",emoji:"🥬",description:"Fresh green leafy vegetables."},
{id:8,name:"Organic Corn",category:"Grains",price:40,unit:"kg",stock:90,farmer:"Green Valley Farm",emoji:"🌽",description:"Fresh corn from the farm."}
];

function read(key,fallback){
try{const v=localStorage.getItem(key);return v===null?fallback:JSON.parse(v)}
catch(e){return fallback}
}

let products=read("ag_products",initialProducts);
let users=read("ag_users",[]);
let cart=read("ag_cart",[]);
let orders=read("ag_orders",[]);
let addresses=read("ag_addresses",[]);
let wallet=read("ag_wallet",1000);
let currentUser=null;
let filter="All";
let search="";
let editingId=null;

function save(){
localStorage.setItem("ag_products",JSON.stringify(products));
localStorage.setItem("ag_users",JSON.stringify(users));
localStorage.setItem("ag_cart",JSON.stringify(cart));
localStorage.setItem("ag_orders",JSON.stringify(orders));
localStorage.setItem("ag_addresses",JSON.stringify(addresses));
localStorage.setItem("ag_wallet",JSON.stringify(wallet));
}

function esc(v){
return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function rupees(v){return "₹"+Number(v).toFixed(2)}
function updateCart(){
document.getElementById("cartCount").textContent=cart.reduce((s,c)=>s+c.qty,0);
}
function updateNav(){
document.getElementById("logoutLink").classList.toggle("hidden",!currentUser);
}
function home(){filter="All";search="";homePage()}

function homePage(){
app.innerHTML=`
<section class="hero">
<div>
<h1>Fresh From Our Farms<br>To Your Home 🌱</h1>
<p>Discover fresh vegetables, fruits and grains directly from farmers. Shop farm-fresh products at fair prices with AgriMart.</p>
<button onclick="productsPage()">Shop Products →</button>
<button onclick="auth('register')" style="background:white;margin-left:8px">Join AgriMart</button>
</div><div class="hero-icon">👨‍🌾🌾</div>
</section>
<div class="heading"><h2>Shop by Category</h2></div>
<div class="categories">
<div class="category" onclick="chooseCategory('All')"><div>🛒</div><h3>All Products</h3></div>
<div class="category" onclick="chooseCategory('Vegetables')"><div>🥦</div><h3>Vegetables</h3></div>
<div class="category" onclick="chooseCategory('Fruits')"><div>🍎</div><h3>Fruits</h3></div>
<div class="category" onclick="chooseCategory('Grains')"><div>🌾</div><h3>Grains</h3></div>
</div>
<div class="heading"><h2>Fresh Products</h2><button class="light" onclick="productsPage()">View All</button></div>
<div id="featured" class="grid"></div>
<div class="heading"><h2>Why Choose AgriMart?</h2></div>
<div class="categories">
<div class="category"><div>🌱</div><h3>Fresh Produce</h3><p>Quality farm products</p></div>
<div class="category"><div>🤝</div><h3>Direct Farmers</h3><p>Support local farmers</p></div>
<div class="category"><div>💰</div><h3>Fair Prices</h3><p>Clear product prices</p></div>
<div class="category"><div>🚚</div><h3>Order Tracking</h3><p>Track your orders</p></div>
</div>`;
renderCards("featured",products.slice(0,4));
}

function chooseCategory(c){filter=c;search="";productsPage()}

function productsPage(){
app.innerHTML=`<div class="heading"><h2>All Products</h2></div>
<div class="toolbar">
<input id="searchBox" placeholder="Search products..." value="${esc(search)}" oninput="search=this.value;renderFiltered()">
<select id="categoryBox" onchange="filter=this.value;renderFiltered()">
${["All","Vegetables","Fruits","Grains","Other"].map(c=>`<option ${filter===c?"selected":""}>${c}</option>`).join("")}
</select>
</div><div id="allProducts" class="grid"></div>`;
renderFiltered();
}
function renderFiltered(){
const el=document.getElementById("allProducts");if(!el)return;
const found=products.filter(p=>(filter==="All"||p.category===filter)&&(`${p.name} ${p.category} ${p.farmer}`.toLowerCase().includes(search.toLowerCase())));
renderCards("allProducts",found);
}
function renderCards(id,list){
const el=document.getElementById(id);if(!el)return;
if(!list.length){el.innerHTML='<div class="empty">No products found.</div>';return}
el.innerHTML=list.map(p=>`
<div class="card">
<div class="product-image">${esc(p.emoji)}</div>
<div class="card-body">
<span class="badge">${esc(p.category)}</span>
<h3>${esc(p.name)}</h3>
<p>${esc(p.description)}</p>
<p>Farmer: ${esc(p.farmer)}</p>
<p>Stock: ${p.stock} ${esc(p.unit)}</p>
<div class="price">${rupees(p.price)} / ${esc(p.unit)}</div>
<div class="card-buttons">
<button class="green" onclick="addCart(${p.id})">Add to Cart</button>
<button class="light" onclick="details(${p.id})">Details</button>
</div></div></div>`).join("");
}
function details(id){
const p=products.find(x=>x.id===id);if(!p)return;
document.getElementById("modal").innerHTML=`<div class="modal-bg" onclick="if(event.target===this)closeModal()"><div class="modal">
<div class="modal-title"><h2>Product Details</h2><button class="light" onclick="closeModal()">✕</button></div>
<div style="font-size:65px;text-align:center">${esc(p.emoji)}</div>
<h3>${esc(p.name)}</h3><p>${esc(p.description)}</p>
<p style="margin-top:10px">Category: ${esc(p.category)}</p><p>Farmer: ${esc(p.farmer)}</p>
<p>Stock: ${p.stock} ${esc(p.unit)}</p><div class="price">${rupees(p.price)} / ${esc(p.unit)}</div>
<button class="green" onclick="closeModal();addCart(${p.id})">Add to Cart</button>
</div></div>`;
}
function closeModal(){document.getElementById("modal").innerHTML=""}

function addCart(id){
const p=products.find(x=>x.id===id);if(!p)return;
let item=cart.find(x=>x.id===id);
if(p.stock<1){alert("Out of stock.");return}
if(item){if(item.qty>=p.stock){alert("Stock limit reached.");return}item.qty++}
else cart.push({id,qty:1});
save();updateCart();alert("Added to cart successfully.");
}
function cartPage(){
if(!cart.length){
app.innerHTML=`<div class="empty"><div style="font-size:55px">🛒</div><h2>Your Cart Is Empty</h2><button class="green" onclick="productsPage()">Shop Now</button></div>`;return;
}
let rows=cart.map(c=>({...c,p:products.find(p=>p.id===c.id)})).filter(c=>c.p);
let total=rows.reduce((s,c)=>s+c.p.price*c.qty,0);
app.innerHTML=`<div class="heading"><h2>My Shopping Cart</h2></div>
<div class="panel"><div class="table-wrap"><table>
<tr><th>Product</th><th>Price</th><th>Quantity</th><th>Total</th><th>Action</th></tr>
${rows.map(c=>`<tr><td>${esc(c.p.emoji)} ${esc(c.p.name)}</td><td>${rupees(c.p.price)}</td>
<td><button class="light" onclick="changeQty(${c.id},-1)">−</button> ${c.qty} <button class="light" onclick="changeQty(${c.id},1)">+</button></td>
<td>${rupees(c.p.price*c.qty)}</td><td><button class="red" onclick="removeCart(${c.id})">Remove</button></td></tr>`).join("")}
</table></div><div style="text-align:right;margin-top:20px"><h2>Total: ${rupees(total)}</h2>
<button class="light" onclick="productsPage()">Continue Shopping</button> <button class="green" onclick="checkout()">Checkout</button></div></div>`;
}
function changeQty(id,d){
const c=cart.find(x=>x.id===id),p=products.find(x=>x.id===id);if(!c||!p)return;
if(d>0&&c.qty>=p.stock){alert("Stock limit reached.");return}
c.qty+=d;if(c.qty<=0)cart=cart.filter(x=>x.id!==id);
save();updateCart();cartPage();
}
function removeCart(id){cart=cart.filter(x=>x.id!==id);save();updateCart();cartPage()}

function checkout(){
if(!currentUser){alert("Please log in first.");auth("login");return}
if(currentUser.role!=="customer"){alert("Log in using a customer account to order.");return}
const total=cart.reduce((s,c)=>{const p=products.find(x=>x.id===c.id);return s+(p?p.price*c.qty:0)},0);
if(!cart.length){alert("Your cart is empty.");return}
app.innerHTML=`<div class="heading"><h2>Checkout</h2></div><div class="panel">
<div class="field"><label>Full Name</label><input id="shipName" value="${esc(currentUser.name)}"></div>
<div class="field"><label>Mobile Number</label><input id="shipPhone" value="${esc(currentUser.phone)}"></div>
<div class="field"><label>Delivery Address</label><textarea id="shipAddress">${esc(addresses[0]||currentUser.address||"")}</textarea></div>
<div class="field"><label>Payment Method</label><select id="payMethod"><option value="COD">Cash on Delivery (Demo)</option><option value="wallet">AgriMart Wallet (Demo)</option></select></div>
<div class="notice">This demo does not collect real payments.</div><h2>Total: ${rupees(total)}</h2>
<button class="green" onclick="placeOrder()">Place Order</button> <button class="light" onclick="cartPage()">Back to Cart</button></div>`;
}
function placeOrder(){
const name=document.getElementById("shipName").value.trim(),phone=document.getElementById("shipPhone").value.trim(),address=document.getElementById("shipAddress").value.trim(),method=document.getElementById("payMethod").value;
if(!name||!phone||!address){alert("Fill in all delivery details.");return}
for(const c of cart){const p=products.find(x=>x.id===c.id);if(!p||p.stock<c.qty){alert("Insufficient stock for a product.");return}}
const total=cart.reduce((s,c)=>s+products.find(p=>p.id===c.id).price*c.qty,0);
if(method==="wallet"&&wallet<total){alert("Insufficient demo wallet balance.");return}
if(method==="wallet")wallet-=total;
const order={id:"AG"+Date.now().toString().slice(-7),name,email:currentUser.email,phone,address,items:cart.map(c=>({...c})),total,status:"Order Placed",shipping:"Not Shipped",payment:method==="wallet"?"Wallet (Demo)":"Cash on Delivery (Demo)",date:new Date().toLocaleString()};
cart.forEach(c=>products.find(p=>p.id===c.id).stock-=c.qty);
orders.unshift(order);addresses=[address,...addresses.filter(a=>a!==address)];cart=[];save();updateCart();
app.innerHTML=`<div class="empty"><div style="font-size:60px">✅</div><h2>Order Placed Successfully!</h2><p>Order ID: ${order.id}</p><p style="margin:12px">Total: ${rupees(total)}</p><button class="green" onclick="ordersPage()">View Orders</button></div>`;
}

function ordersPage(){
if(!currentUser){alert("Please log in first.");auth("login");return}
let list=orders.filter(o=>currentUser.role==="customer"?o.email===currentUser.email:o.items.some(i=>{const p=products.find(x=>x.id===i.id);return p&&p.farmer===currentUser.name}));
app.innerHTML=`<div class="heading"><h2>${currentUser.role==="farmer"?"Manage Customer Orders":"My Orders"}</h2></div>
${list.length?list.map(o=>`<div class="panel"><div class="heading"><h3>Order ${esc(o.id)}</h3><span class="badge">${esc(o.status)}</span></div>
<p>Customer: ${esc(o.name)}</p><p>Date: ${esc(o.date)}</p><p>Address: ${esc(o.address)}</p><p>Payment: ${esc(o.payment)}</p><p>Shipping: <b>${esc(o.shipping)}</b></p>
<div style="margin:12px 0">${o.items.map(i=>{const p=products.find(x=>x.id===i.id);return `<p>${p?esc(p.name):"Product"} × ${i.qty}</p>`}).join("")}</div>
<h3>Total: ${rupees(o.total)}</h3>
${currentUser.role==="farmer"?`<div class="actions"><select id="status${o.id}"><option>Order Placed</option><option>Confirmed</option><option>Packed</option><option>Cancelled</option></select><button class="green" onclick="updateStatus('${o.id}')">Update Status</button>
<select id="ship${o.id}"><option>Not Shipped</option><option>Shipped</option><option>Out for Delivery</option><option>Delivered</option></select><button class="light" onclick="updateShipping('${o.id}')">Update Shipping</button></div>`:""}</div>`).join(""):`<div class="empty"><h3>No orders found</h3><button class="green" onclick="productsPage()">Shop Now</button></div>`}`;
}
function updateStatus(id){const o=orders.find(x=>x.id===id);if(o){o.status=document.getElementById("status"+id).value;save();ordersPage()}}
function updateShipping(id){const o=orders.find(x=>x.id===id);if(o){o.shipping=document.getElementById("ship"+id).value;save();ordersPage()}}

function auth(mode){
const reg=mode==="register",farmer=mode==="farmer";
document.getElementById("modal").innerHTML=`<div class="modal-bg" onclick="if(event.target===this)closeModal()"><div class="modal">
<div class="modal-title"><h2>${reg?"Create Account":"Login"}</h2><button class="light" onclick="closeModal()">✕</button></div>
${reg?`<div class="field"><label>Full Name</label><input id="aName" placeholder="Full name"></div><div class="field"><label>Mobile Number</label><input id="aPhone" type="tel" placeholder="Mobile number"></div>`:""}
<div class="field"><label>Email Address</label><input id="aEmail" type="email" placeholder="Email address"></div>
${reg?`<div class="field"><label>Address</label><textarea id="aAddress" placeholder="Full address"></textarea></div>`:""}
<div class="field"><label>Account Type</label><select id="aRole">${reg?`<option value="customer">Customer</option><option value="farmer">Farmer</option>`:`<option value="${farmer?"farmer":"customer"}">${farmer?"Farmer":"Customer"}</option><option value="${farmer?"customer":"farmer"}">${farmer?"Customer":"Farmer"}</option>`}</select></div>
<div class="field"><label>Password</label><input id="aPassword" type="password" placeholder="Password"></div>
${reg?`<div class="field"><label>Confirm Password</label><input id="aConfirm" type="password" placeholder="Confirm password"></div>`:""}
<button class="green" onclick="submitAuth('${mode}')">${reg?"Register":"Login"}</button>
<p style="margin-top:15px">${reg?"Already have an account?":"New to AgriMart?"} <a href="#" onclick="event.preventDefault();auth('${reg?"login":"register"}')">${reg?"Login":"Register"}</a></p>
<p class="small">No OTP verification is required.</p></div></div>`;
}
function submitAuth(mode){
const reg=mode==="register",nameEl=document.getElementById("aName"),phoneEl=document.getElementById("aPhone"),addressEl=document.getElementById("aAddress");
const name=nameEl?nameEl.value.trim():"",phone=phoneEl?phoneEl.value.trim():"",address=addressEl?addressEl.value.trim():"";
const email=document.getElementById("aEmail").value.trim().toLowerCase(),password=document.getElementById("aPassword").value,role=document.getElementById("aRole").value;
if(!email||!password){alert("Enter your email and password.");return}
if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){alert("Enter a valid email address.");return}
if(reg){
if(!name||!phone||!address){alert("Complete all registration details.");return}
if(password.length<6){alert("Password must be at least 6 characters.");return}
if(password!==document.getElementById("aConfirm").value){alert("Passwords do not match.");return}
if(users.some(u=>u.email===email)){alert("Email already registered. Please log in.");return}
users.push({name,phone,address,email,password,role});save();
alert("Registration successful. Now log in with your email and password.");auth("login");return;
}
let user=users.find(u=>u.email===email&&u.password===password&&u.role===role);
if(!user&&email==="than@gmail.com"&&password==="thanmai7971"&&role==="customer"){
user={name:"Thanmai",phone:"",address:"",email,password,role};
if(!users.some(u=>u.email===email)){users.push(user);save()}
}
if(!user){alert("Incorrect login details. Please check your email, password and account type.");return}
currentUser=user;closeModal();updateNav();dashboard();
}

function dashboard(){
if(!currentUser){auth("login");return}
updateNav();
if(currentUser.role==="farmer"){farmerDashboard();return}
const mine=orders.filter(o=>o.email===currentUser.email);
app.innerHTML=`<div class="heading"><h2>Welcome, ${esc(currentUser.name)} 👋</h2><button class="light" onclick="logout()">Logout</button></div>
<div class="stats"><div class="stat"><p>My Orders</p><h2>${mine.length}</h2></div><div class="stat"><p>Wallet Balance (Demo)</p><h2>${rupees(wallet)}</h2></div><div class="stat"><p>Cart Items</p><h2>${cart.reduce((s,c)=>s+c.qty,0)}</h2></div></div>
