    $("dashContent").innerHTML=html;
}

function bookingTable(list,admin){
    if(!list.length)return "<p>No bookings found.</p>";
    return `<div class="table-wrap"><table><thead><tr><th>Vehicle</th><th>Customer</th><th>Pickup</th><th>Return</th><th>Time</th><th>Total</th><th>Status</th>${admin?"<th>Action</th>":"<th>Check-in</th>"}</tr></thead><tbody>
    ${list.map(b=>`<tr><td>${escapeHTML(b.vehicleName)}</td><td>${escapeHTML(b.userName)}</td><td>${escapeHTML(b.pickup)}</td><td>${escapeHTML(b.returnDate)}</td><td>${escapeHTML(b.time)}</td><td>₹${Number(b.total)}</td><td><span class="badge ${b.status==="Approved"?"approved":b.status==="Rejected"||b.status==="Cancelled"?"rejected":"pending"}">${escapeHTML(b.status)}</span></td><td>${admin&&b.status==="Pending"?`<button class="btn btn-green" onclick="updateBooking('${b.id}','Approved')">Approve</button> <button class="btn btn-red" onclick="updateBooking('${b.id}','Rejected')">Reject</button>`:admin?escapeHTML(b.checkinStatus):escapeHTML(b.checkinStatus)}</td></tr>`).join("")}
    </tbody></table></div>`;
}

function updateBooking(bookingId,status){
    const bookings=read("rrBookings");
    const b=bookings.find(x=>x.id===bookingId);
    if(!b)return;
    if(status==="Approved"){
        const conflict=bookings.some(x=>x.id!==b.id&&x.vehicleId===b.vehicleId&&x.status==="Approved"&&!(new Date(b.returnDate)<new Date(x.pickup)||new Date(b.pickup)>new Date(x.returnDate)));
        if(conflict)return notify("This vehicle already has an approved booking during those dates.");
    }
    b.status=status;
    save("rrBookings",bookings);
    notify("Booking status updated to "+status+".");
    dashboardPage("Manage Bookings");
}

function submitCheckin(e){
    e.preventDefault();
    const u=requireUser();if(!u)return;
    const f=new FormData(e.target);
    const booking=read("rrBookings").find(b=>b.id===f.get("bookingId")&&b.userId===u.id&&b.status==="Approved");
    if(!booking)return notify("Select a valid approved booking.");
    const items=read("rrCheckins");
    items.push({id:makeId(),bookingId:booking.id,userId:u.id,licence:f.get("licence"),notes:f.get("notes"),date:new Date().toLocaleDateString()});
    save("rrCheckins",items);
    booking.checkinStatus="Submitted";
    save("rrBookings",read("rrBookings").map(b=>b.id===booking.id?booking:b));
    notify("Check-in form submitted.");
    dashboardPage("My Bookings");
}

function addVehicle(e){
    e.preventDefault();
    const f=new FormData(e.target),vehicles=read("rrVehicles");
    vehicles.push({
        id:makeId(),name:f.get("name"),type:f.get("type"),
        price:Number(f.get("price")),location:f.get("location"),
        seats:Number(f.get("seats")||5),fuel:f.get("fuel"),
        transmission:f.get("transmission"),emoji:f.get("emoji"),
        description:f.get("description"),available:true
    });
    save("rrVehicles",vehicles);
    notify("Vehicle added successfully.");
    dashboardPage("Manage Vehicles");
}

function editVehicle(vehicleId){
    const v=read("rrVehicles").find(x=>x.id===vehicleId);
    if(!v)return;
    const name=prompt("Vehicle name:",v.name);
    if(name===null)return;
    const price=prompt("Price per day:",v.price);
    if(price===null)return;
    const location=prompt("Location:",v.location);
    if(location===null)return;
    if(!name.trim()||!Number.isFinite(Number(price))||Number(price)<=0)return notify("Enter a valid name and price.");
    v.name=name.trim();v.price=Number(price);v.location=location.trim();
    save("rrVehicles",read("rrVehicles").map(x=>x.id===v.id?v:x));
    dashboardPage("Manage Vehicles");
}
function toggleVehicle(vehicleId){
    const vehicles=read("rrVehicles");
    const v=vehicles.find(x=>x.id===vehicleId);
    if(!v)return;
    v.available=!v.available;
    save("rrVehicles",vehicles);
    dashboardPage("Manage Vehicles");
}
function updateProfile(e){
    e.preventDefault();
    const u=requireUser();if(!u)return;
    const f=new FormData(e.target),users=read("rrUsers");
    const index=users.findIndex(x=>x.id===u.id);
    users[index]={...users[index],name:f.get("name"),phone:f.get("phone"),address:f.get("address")};
    save("rrUsers",users);setUser(users[index]);
    notify("Profile updated successfully.");
    dashboardPage("My Profile");
}
function addReview(e){
    e.preventDefault();
    const u=requireUser();if(!u)return;
    const f=new FormData(e.target),reviews=read("rrReviews");
    reviews.unshift({id:makeId(),userId:u.id,name:u.name,rating:Number(f.get("rating")),text:f.get("text"),date:new Date().toLocaleDateString()});
    save("rrReviews",reviews);
    notify("Review submitted successfully.");
    dashboardPage("Reviews");
}
function reviewsHTML(){
    const reviews=read("rrReviews");
    return reviews.length?`<div class="grid">${reviews.map(r=>`<div class="card"><h3>${escapeHTML(r.name)}</h3><div class="rating">${"★".repeat(r.rating)}${"☆".repeat(5-r.rating)}</div><p>${escapeHTML(r.text)}</p><p class="small">${escapeHTML(r.date)}</p></div>`).join("")}</div>`:"<p>No reviews yet. Be the first to share your experience.</p>";
}
function showReviews(){
    $("app").innerHTML=`<div class="container"><h2 class="section-title">Customer Reviews</h2>${reviewsHTML()}<br><button class="btn" onclick="showLogin()">Login to Write a Review</button></div>`;
}

showHome();
</script>
</body>
</html>
