<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>EasyToll | Travel without the queue</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}:root{--blue:#155da8;--deep:#12365c;--gold:#f0a323;--pale:#eff6fd;--line:#d4e2f0;--red:#b3261e;--green:#287653}body{font-family:Arial,sans-serif;background:#f7faff;color:#243341;line-height:1.55}header{background:var(--deep);color:#fff;position:sticky;top:0;z-index:3}.bar{max-width:1100px;margin:auto;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.brand{font-size:23px;font-weight:bold;color:white;text-decoration:none}nav{display:flex;gap:6px;flex-wrap:wrap}nav a{color:white;text-decoration:none;padding:7px 10px;border-radius:5px;font-size:14px}nav a:hover,nav a.on{background:var(--blue)}main{max-width:1100px;margin:22px auto;padding:0 16px;min-height:72vh}.hero{padding:32px 20px;background:linear-gradient(135deg,#12365c,#247dcc);color:#fff;border-radius:12px;text-align:center;margin-bottom:20px}.hero h1{font-size:32px;margin-bottom:7px}.panel{background:#fff;border:1px solid var(--line);border-radius:10px;padding:18px;margin-bottom:18px}.panel h2{color:var(--deep);font-size:21px;border-bottom:2px solid var(--gold);padding-bottom:6px;margin-bottom:13px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}.card{border:1px solid var(--line);border-radius:9px;padding:14px;background:#fff}.card h3{color:var(--deep)}.field{max-width:520px}label{display:block;font-weight:bold;font-size:13px;margin:10px 0 3px}input,select,textarea{width:100%;padding:9px;border:1px solid #bdcbd8;border-radius:5px;font:inherit}.btn{display:inline-block;border:0;border-radius:6px;background:var(--blue);color:#fff;padding:9px 14px;cursor:pointer;text-decoration:none;margin:8px 5px 0 0;font-size:14px}.btn:hover{background:var(--deep)}.btn.gold{background:#d68b13}.btn.gray{background:#727b82}.btn.red{background:var(--red)}.btn.small{font-size:12px;padding:5px 9px}.muted{color:#657687;font-size:13px}.tag{display:inline-block;background:#e6f1fc;color:var(--deep);border-radius:20px;padding:2px 9px;font-size:12px;margin:3px}.balance{font-size:30px;color:var(--green);font-weight:bold}.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}.tabs button{border:0;border-radius:5px;padding:8px 12px;background:#e6f1fc;cursor:pointer}.tabs .on{background:var(--blue);color:white}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;font-size:14px}th,td{padding:8px;border:1px solid var(--line);text-align:left;vertical-align:top}th{background:var(--pale)}.msg{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:var(--green);color:white;padding:10px 16px;border-radius:7px;display:none;z-index:6;max-width:90%}.msg.bad{background:var(--red)}.qr{width:180px;height:180px;border:8px solid white;outline:1px solid var(--line);display:grid;place-items:center;background:repeating-conic-gradient(#111 0% 25%,#fff 0% 50%) 50%/18px 18px;color:#fff;text-shadow:0 1px 4px #000;font-weight:bold;margin:10px 0}.pass{border:2px dashed var(--blue);background:#f3f8fe;border-radius:10px;padding:14px}footer{text-align:center;background:var(--deep);color:white;padding:14px;font-size:13px}@media(max-width:650px){.hero h1{font-size:25px}}
</style></head><body><header><div class="bar"><a href="#" class="brand" data-page="home">🛣️ EasyToll</a><nav id="nav"></nav></div></header><main id="app"></main><footer>EasyToll · Advance toll payment demo · No real payments are processed</footer><div id="msg" class="msg"></div>
<script>
// Classroom demonstration only. Records are stored in this browser; no real payment or QR scan is performed.
const KEY='easyTollDB',UK='easyTollUser';const seed=()=>({next:5,users:[{name:'EasyToll Administrator',email:'admin@easytoll.com',phone:'',password:'admin123',role:'admin'},{name:'Sample Driver',email:'driver@demo.com',phone:'9000000000',password:'driver123',role:'driver'},{name:'Sample Toll Operator',email:'gate@demo.com',phone:'',password:'gate123',role:'gate',gateId:1}],gates:[{id:1,name:'Greenfield Toll Plaza',location:'Chennai–Bengaluru Highway',fee:120},{id:2,name:'Riverbend Toll Plaza',location:'Outer Ring Road',fee:80},{id:3,name:'Hillview Toll Plaza',location:'Salem Bypass',fee:100}],vehicles:[],wallets:{},passes:[],tickets:[],transactions:[],scans:[]});let db;try{db=JSON.parse(localStorage.getItem(KEY))}catch{}if(!db||!db.gates)db=seed();let page='home',tab='overview';const save=()=>localStorage.setItem(KEY,JSON.stringify(db)),me=()=>db.users.find(u=>u.email===sessionStorage.getItem(UK)),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function toast(s,b=false){let e=document.querySelector('#msg');e.textContent=s;e.className='msg'+(b?' bad':'');e.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display='none',3200)}function go(p){page=p;render();scrollTo(0,0)}function inp(n,l,t='text',a='required'){return `<label>${l}</label><input name="${n}" type="${t}" ${a}>`}function userWallet(u){if(!db.wallets[u.email])db.wallets[u.email]=0;return db.wallets[u.email]}function form(title,id,fields,extra=''){return `<section class="panel field"><h2>${title}</h2><form id="${id}">${fields}<button class="btn">Submit</button></form>${extra}</section>`}function codePass(kind,id){return `<div class="pass"><b>${kind} ID: ${esc(id)}</b><div class="qr">QR DEMO<br>${esc(id)}</div><p class="muted">Reference QR preview only. This demo does not create a scannable QR code.</p></div>`}
function render(){let u=me(),links=[['home','Home']];if(!u)links.push(['login','Login'],['register','Register']);else if(u.role==='driver')links.push(['driver','My Toll Account'],['logout','Logout']);else if(u.role==='admin')links.push(['admin','Admin Panel'],['logout','Logout']);else links.push(['gate','Toll Gate'],['logout','Logout']);document.querySelector('#nav').innerHTML=links.map(([p,t])=>`<a href="#" data-page="${p}" class="${page===p?'on':''}">${t}</a>`).join('');let html='';
if(page==='home')html=`<section class="hero"><h1>Pay ahead. Pass through.</h1><p>Manage toll funds, passes and eTickets before your journey.</p><button class="btn gold" data-page="login">Access your toll account</button></section><section class="panel"><h2>Available Toll Plazas</h2><div class="grid">${db.gates.map(g=>`<article class="card"><h3>${esc(g.name)}</h3><p>${esc(g.location)}</p><p>Standard toll: <b>₹${g.fee}</b></p></article>`).join('')}</div></section><section class="panel"><h2>Demo accounts</h2><p>Administrator: admin@easytoll.com / admin123</p><p>Driver: driver@demo.com / driver123</p><p>Toll operator: gate@demo.com / gate123</p></section>`;
if(page==='login')html=form('Login','login',`<label>Login as</label><select name="role"><option value="driver">Driver</option><option value="gate">Toll Gate User</option><option value="admin">Administrator</option></select>`+inp('email','Email','email')+inp('password','Password','password'),`<p class="muted">New driver? <a href="#" data-page="register">Register here</a><br>Demo admin: admin@easytoll.com / admin123 | Toll operator: gate@demo.com / gate123</p>`);
if(page==='register')html=form('Driver Registration','register',inp('name','Full name')+inp('email','Email','email')+inp('phone','Phone','tel')+inp('password','Password (minimum 6 characters)','password','minlength="6" required'));
if(page==='driver'){let u=me();if(u?.role!=='driver')page='login';else{let v=db.vehicles.filter(x=>x.email===u.email),ps=db.passes.filter(x=>x.email===u.email),ts=db.tickets.filter(x=>x.email===u.email);html=`<section class="panel"><h2>Welcome, ${esc(u.name)}</h2><p>eWallet balance</p><p class="balance">₹${userWallet(u)}</p><div class="tabs"><button data-tab="overview" class="${tab==='overview'?'on':''}">Overview</button><button data-tab="vehicles" class="${tab==='vehicles'?'on':''}">Vehicles</button><button data-tab="passes" class="${tab==='passes'?'on':''}">Toll passes</button><button data-tab="tickets" class="${tab==='tickets'?'on':''}">eTickets</button><button data-tab="history" class="${tab==='history'?'on':''}">Transactions</button></div>`;
if(tab==='overview')html+=`<div class="grid"><article class="card"><h3>Add money</h3><form id="wallet">${inp('amount','Amount (₹)','number','required min="1"')}<button class="btn">Add to demo wallet</button></form></article><article class="card"><h3>Buy toll eTicket</h3><form id="buyticket"><label>Toll plaza</label><select name="gate">${db.gates.map(g=>`<option value="${g.id}">${esc(g.name)} · ₹${g.fee}</option>`).join('')}</select><label>Vehicle</label><select name="vehicle">${v.map(x=>`<option value="${esc(x.plate)}">${esc(x.plate)} · ${esc(x.model)}</option>`).join('')||'<option value="">Add a vehicle first</option>'}</select>${inp('date','Travel date','date','required')}<button class="btn">Buy ticket</button></form></article><article class="card"><h3>Apply / renew toll pass</h3><form id="applypass"><label>Vehicle</label><select name="vehicle">${v.map(x=>`<option>${esc(x.plate)}</option>`).join('')||'<option value="">Add a vehicle first</option>'}</select><label>Pass type</label><select name="type"><option>Monthly</option><option>Quarterly</option><option>Annual</option></select><label>Renewal</label><select name="renew"><option>No</option><option>Yes</option></select><button class="btn">Apply for approval</button></form></article></div>`;
if(tab==='vehicles')html+=`<h3>Add a vehicle</h3><form id="vehicle" class="grid">${inp('plate','Vehicle registration number')}${inp('model','Make / model')}<label>Vehicle type<select name="type"><option>Car / SUV</option><option>Motorcycle</option><option>Light commercial vehicle</option><option>Bus / Truck</option></select></label><button class="btn">Save vehicle</button></form><div class="grid">${v.map(x=>`<article class="card"><b>${esc(x.plate)}</b><p>${esc(x.model)} · ${esc(x.type)}</p></article>`).join('')}</div>`;
if(tab==='passes')html+=`<h3>Your toll pass applications</h3>${ps.map(p=>`<article class="card"><b>${esc(p.id)}</b> · ${esc(p.type)} pass for ${esc(p.vehicle)} · ${esc(p.status)}${p.status==='Approved'?codePass('PASS',p.id):''}</article>`).join('')||'<p>No pass applications yet.</p>'}`;
if(tab==='tickets')html+=`<h3>Your eTickets</h3>${ts.map(t=>`<article class="card"><b>${esc(t.id)}</b> · ${esc(t.gateName)} · ${esc(t.date)} · ${esc(t.status)}<p>Vehicle ${esc(t.vehicle)} · ₹${t.fee}</p>${codePass('TICKET',t.id)}</article>`).join('')||'<p>No eTickets yet.</p>'}`;
if(tab==='history')html+=`<div class="scroll"><table><tr><th>Date</th><th>Activity</th><th>Amount</th><th>Reference</th></tr>${db.transactions.filter(t=>t.email===u.email).map(t=>`<tr><td>${esc(t.date)}</td><td>${esc(t.label)}</td><td>₹${t.amount}</td><td>${esc(t.ref)}</td></tr>`).join('')||'<tr><td colspan="4">No transactions yet.</td></tr>'}</table></div>`;html+='</section>'}}
if(page==='gate'){let u=me();if(u?.role!=='gate')page='login';else{let g=db.gates.find(x=>x.id===u.gateId)||db.gates[0];html=`<section class="panel"><h2>Toll Gate Console</h2><p>Signed in as ${esc(u.name)}</p><p>Current location: <b>${esc(g.name)} — ${esc(g.location)}</b></p><form id="scan" class="field"><label>Scan QR or enter pass / ticket ID</label><input name="code" placeholder="Example: PASS1001 or TKT1002" required><button class="btn">Verify</button></form>${db.scans.filter(x=>x.gateId===g.id).slice(-8).reverse().map(s=>`<article class="card"><b>${esc(s.code)}</b> · ${esc(s.result)}<p>${esc(s.time)}</p></article>`).join('')}</section><section class="panel"><h2>Update toll location</h2><form id="location" class="field"><label>Gate</label><select name="gate">${db.gates.map(x=>`<option value="${x.id}" ${x.id===g.id?'selected':''}>${esc(x.name)}</option>`).join('')}</select><button class="btn">Set location</button></form></section>`}}
if(page==='admin'&&me()?.role==='admin'){html=`<section class="panel"><h2>EasyToll Administration</h2><div class="tabs"><button data-tab="overview" class="${tab==='overview'?'on':''}">Summary</button><button data-tab="users" class="${tab==='users'?'on':''}">Users & operators</button><button data-tab="passes" class="${tab==='passes'?'on':''}">Toll passes</button><button data-tab="gates" class="${tab==='gates'?'on':''}">Toll details</button></div>`;
if(tab==='overview')html+=`<div class="grid"><article class="card"><h3>Drivers</h3>${db.users.filter(x=>x.role==='driver').length}</article><article class="card"><h3>Pass approvals pending</h3>${db.passes.filter(x=>x.status==='Pending').length}</article><article class="card"><h3>Toll plazas</h3>${db.gates.length}</article><article class="card"><h3>Tickets issued</h3>${db.tickets.length}</article></div>`;
if(tab==='users')html+=`<h3>Register toll gate operator</h3><form id="newoperator" class="grid">${inp('name','Operator name')}${inp('email','Email','email')}${inp('password','Password','password','minlength="6" required')}<label>Assigned gate<select name="gate">${db.gates.map(g=>`<option value="${g.id}">${esc(g.name)}</option>`).join('')}</select></label><button class="btn">Create operator account</button></form><div class="scroll"><table><tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Vehicles</th><th>Action</th></tr>${db.users.filter(x=>x.role!=='admin').map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.email)}</td><td>${esc(x.phone)}</td><td>${x.role}</td><td>${db.vehicles.filter(v=>v.email===x.email).map(v=>esc(v.plate)).join(', ')}</td><td><button class="btn red small" data-act="deluser" data-id="${encodeURIComponent(x.email)}">Delete</button></td></tr>`).join('')}</table></div>`;
if(tab==='passes')html+=`<div class="scroll"><table><tr><th>Pass</th><th>Driver</th><th>Vehicle</th><th>Type</th><th>Renewal</th><th>Status</th><th>Action</th></tr>${db.passes.map(p=>`<tr><td>${esc(p.id)}</td><td>${esc(p.email)}</td><td>${esc(p.vehicle)}</td><td>${esc(p.type)}</td><td>${p.renew}</td><td>${p.status}</td><td>${p.status==='Pending'?`<button class="btn small" data-act="approve" data-id="${p.id}">Approve & generate QR</button>`:p.status}</td></tr>`).join('')||'<tr><td colspan="7">No applications.</td></tr>'}</table></div>`;
if(tab==='gates')html+=`<h3>Create toll details</h3><form id="newgate" class="grid">${inp('name','Toll plaza name')}${inp('location','Road / location')}${inp('fee','Standard fee (₹)','number','required min="0"')}<button class="btn">Create toll plaza</button></form><div class="scroll"><table><tr><th>Gate</th><th>Location</th><th>Fee</th><th></th></tr>${db.gates.map(g=>`<tr><td>${esc(g.name)}</td><td>${esc(g.location)}</td><td><input type="number" data-fee="${g.id}" value="${g.fee}" style="width:100px"></td><td><button class="btn red small" data-act="delgate" data-id="${g.id}">Delete</button></td></tr>`).join('')}</table></div>`;html+='</section>'}
document.querySelector('#app').innerHTML=html||''}
document.addEventListener('click',e=>{let p=e.target.closest('[data-page]'),t=e.target.closest('[data-tab]'),a=e.target.closest('[data-act]');if(p){e.preventDefault();go(p.dataset.page);return}if(t){tab=t.dataset.tab;render();return}if(!a)return;let id=a.dataset.id;if(a.dataset.act==='logout'){sessionStorage.removeItem(UK);go('home')}if(a.dataset.act==='approve'){let x=db.passes.find(p=>p.id===id);x.status='Approved';x.expiry=new Date(Date.now()+30*86400000).toISOString().slice(0,10);save();toast('Pass approved and demo QR generated.');render()}if(a.dataset.act==='deluser'){let email=decodeURIComponent(id);db.users=db.users.filter(u=>u.email!==email);save();render()}if(a.dataset.act==='delgate'){db.gates=db.gates.filter(g=>g.id!==Number(id));save();render()}});
document.addEventListener('change',e=>{if(e.target.dataset.fee){let g=db.gates.find(x=>x.id===Number(e.target.dataset.fee));g.fee=Number(e.target.value)||0;save();toast('Toll fee updated')}});
document.addEventListener('submit',e=>{e.preventDefault();let f=e.target,d=new FormData(f),u=me(),today=new Date().toISOString().slice(0,10);if(f.id==='register'){let email=String(d.get('email')).trim().toLowerCase();if(db.users.some(x=>x.email===email))return toast('Email is already registered.',true);db.users.push({name:String(d.get('name')).trim(),email,phone:String(d.get('phone')).trim(),password:d.get('password'),role:'driver'});save();toast('Registration complete. Please login.');go('login')}if(f.id==='login'){let x=db.users.find(z=>z.email===String(d.get('email')).trim().toLowerCase());if(!x||x.password!==d.get('password'))return toast('Email or password is incorrect.',true);if(x.role!==d.get('role'))return toast('Select the correct account type.',true);sessionStorage.setItem(UK,x.email);tab=x.role==='admin'?'overview':'overview';go(x.role==='admin'?'admin':x.role==='gate'?'gate':'driver')}if(f.id==='wallet'){let amount=Number(d.get('amount'));db.wallets[u.email]=userWallet(u)+amount;db.transactions.push({email:u.email,label:'Wallet top-up (demo)',amount,date:today,ref:'W'+Date.now().toString().slice(-6)});save();toast('Demo wallet topped up.');render()}if(f.id==='vehicle'){db.vehicles.push({email:u.email,plate:String(d.get('plate')).trim().toUpperCase(),model:String(d.get('model')).trim(),type:String(d.get('type'))});save();toast('Vehicle saved.');render()}if(f.id==='buyticket'){let gate=db.gates.find(g=>g.id===Number(d.get('gate'))),vehicle=String(d.get('vehicle'));if(!vehicle)return toast('Add a vehicle before buying a ticket.',true);if(userWallet(u)<gate.fee)return toast('Please add funds to your wallet first.',true);db.wallets[u.email]-=gate.fee;let ticket={id:'TKT'+String(db.next++).padStart(4,'0'),email:u.email,gateId:gate.id,gateName:gate.name,vehicle,date:String(d.get('date')),fee:gate.fee,status:'Valid'};db.tickets.push(ticket);db.transactions.push({email:u.email,label:'Advance toll eTicket: '+gate.name,amount:-gate.fee,date:today,ref:ticket.id});save();tab='tickets';toast('eTicket issued. Show the ticket ID at the toll gate.');render()}if(f.id==='applypass'){let vehicle=String(d.get('vehicle'));if(!vehicle)return toast('Add a vehicle before applying.',true);let pass={id:'PASS'+String(db.next++).padStart(4,'0'),email:u.email,vehicle,type:String(d.get('type')),renew:String(d.get('renew')),status:'Pending'};db.passes.push(pass);save();tab='passes';toast('Pass application submitted for admin approval.');render()}if(f.id==='scan'){let code=String(d.get('code')).trim().toUpperCase(),p=db.passes.find(x=>x.id.toUpperCase()===code&&x.status==='Approved'),ticket=db.tickets.find(x=>x.id.toUpperCase()===code&&x.status==='Valid'),result=p?'PASS VERIFIED · '+p.vehicle:ticket?'TICKET VERIFIED · '+ticket.vehicle:'NOT FOUND / INVALID';db.scans.push({code,result,time:new Date().toLocaleString(),gateId:u.gateId});if(ticket){ticket.status='Used';let tr=db.transactions.find(x=>x.ref===ticket.id);if(tr)tr.label+=' (validated)'}save();toast(result,!p&&!ticket);render()}if(f.id==='location'){u.gateId=Number(d.get('gate'));save();toast('Toll gate location updated.');render()}if(f.id==='newoperator'){let email=String(d.get('email')).trim().toLowerCase();if(db.users.some(x=>x.email===email))return toast('Email is already registered.',true);db.users.push({name:String(d.get('name')),email,password:d.get('password'),phone:'',role:'gate',gateId:Number(d.get('gate'))});save();toast('Toll operator account created.');render()}if(f.id==='newgate'){db.gates.push({id:db.next++,name:String(d.get('name')),location:String(d.get('location')),fee:Number(d.get('fee'))});save();toast('Toll plaza created.');render()}});save();render();
</script></body></html>
