<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ComplainEase | Complaint tracking and resolution</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}:root{--blue:#3155a4;--deep:#23386e;--teal:#15847f;--pale:#f0f4fc;--line:#d7dfef;--red:#b3261e;--green:#287653}body{font-family:Arial,sans-serif;background:#f8f9fd;color:#26313d;line-height:1.55}header{background:var(--deep);color:#fff;position:sticky;top:0;z-index:3}.bar{max-width:1120px;margin:auto;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.brand{font-size:23px;font-weight:bold;color:white;text-decoration:none}nav{display:flex;gap:6px;flex-wrap:wrap}nav a{color:white;text-decoration:none;padding:7px 10px;border-radius:5px;font-size:14px}nav a:hover,nav a.on{background:var(--blue)}main{max-width:1120px;margin:22px auto;padding:0 16px;min-height:72vh}.hero{padding:32px 20px;background:linear-gradient(135deg,#23386e,#4c70c8);color:#fff;border-radius:12px;text-align:center;margin-bottom:20px}.hero h1{font-size:32px;margin-bottom:7px}.panel{background:white;border:1px solid var(--line);border-radius:10px;padding:18px;margin-bottom:18px}.panel h2{color:var(--deep);font-size:21px;border-bottom:2px solid var(--teal);padding-bottom:6px;margin-bottom:13px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}.card{border:1px solid var(--line);border-radius:9px;padding:14px;background:white}.field{max-width:650px}label{display:block;font-weight:bold;font-size:13px;margin:10px 0 3px}input,select,textarea{width:100%;padding:9px;border:1px solid #bdc8d8;border-radius:5px;font:inherit}.btn{display:inline-block;border:0;border-radius:6px;background:var(--blue);color:#fff;padding:9px 14px;cursor:pointer;text-decoration:none;margin:8px 5px 0 0;font-size:14px}.btn:hover{background:var(--deep)}.btn.teal{background:var(--teal)}.btn.red{background:var(--red)}.btn.gray{background:#747b87}.btn.small{font-size:12px;padding:5px 9px}.muted{color:#657181;font-size:13px}.tag{display:inline-block;background:#e8edf9;color:var(--deep);border-radius:20px;padding:2px 9px;font-size:12px;margin:3px}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;font-size:14px}th,td{padding:8px;border:1px solid var(--line);text-align:left;vertical-align:top}th{background:var(--pale)}.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}.tabs button{border:0;border-radius:5px;padding:8px 12px;background:#e8edf9;cursor:pointer}.tabs .on{background:var(--blue);color:white}.status{font-weight:bold;color:var(--teal)}.msg{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:var(--green);color:white;padding:10px 16px;border-radius:7px;display:none;z-index:6;max-width:90%}.msg.bad{background:var(--red)}footer{text-align:center;background:var(--deep);color:white;padding:14px;font-size:13px}@media(max-width:650px){.hero h1{font-size:25px}}
</style></head><body><header><div class="bar"><a href="#" class="brand" data-page="home">🗣️ ComplainEase</a><nav id="nav"></nav></div></header><main id="app"></main><footer>ComplainEase · Complaint management demo · Do not submit sensitive personal information</footer><div id="msg" class="msg"></div>
<script>
// Browser-only classroom demo; accounts and complaint records stay in localStorage. No email/SMS is sent.
const KEY='complainEaseDB',UK='complainEaseUser';const seed=()=>({next:1001,features:{submit:true,tracking:true,feedback:true,faq:true},contact:{name:'ComplainEase Support',email:'support@complainease.demo',phone:'1800-000-000'},users:[{name:'System Administrator',email:'admin@complainease.demo',phone:'',password:'admin123',role:'admin'},{name:'Demo Citizen',email:'user@demo.com',phone:'9000000000',password:'user123',role:'user'},{name:'Demo Officer',email:'officer@demo.com',phone:'',password:'officer123',role:'officer'}],complaints:[],faqs:[{q:'How do I track my complaint?',a:'Sign in and open My Complaints to view the latest status and officer updates.'},{q:'Can I add more information later?',a:'Open a submitted complaint and use Add information to attach a note or evidence reference.'},{q:'How are updates sent?',a:'This demo shows updates in your account. It does not send real email or SMS.'}]});let db;try{db=JSON.parse(localStorage.getItem(KEY))}catch{}if(!db||!db.users)db=seed();let page='home',tab='complaints';const save=()=>localStorage.setItem(KEY,JSON.stringify(db)),me=()=>db.users.find(u=>u.email===sessionStorage.getItem(UK)),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function toast(s,b=false){let e=document.querySelector('#msg');e.textContent=s;e.className='msg'+(b?' bad':'');e.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display='none',3200)}function go(p){page=p;render();scrollTo(0,0)}function inp(n,l,t='text',a='required'){return `<label>${l}</label><input name="${n}" type="${t}" ${a}>`}function form(title,id,fields,extra=''){return `<section class="panel field"><h2>${title}</h2><form id="${id}">${fields}<button class="btn">Submit</button></form>${extra}</section>`}function mapLink(c){if(c.lat&&c.lng)return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(c.lat+','+c.lng)}`;return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(c.location||'')}`}
function render(){let u=me(),links=[['home','Home'],['contact','Admin Contact']];if(!u)links.push(['login','Login'],['register','Register']);else if(u.role==='user')links.push(['user','My Complaints'],['new','Post Complaint'],['logout','Logout']);else if(u.role==='officer')links.push(['officer','Officer Desk'],['logout','Logout']);else links.push(['admin','Admin Panel'],['logout','Logout']);document.querySelector('#nav').innerHTML=links.map(([p,t])=>`<a href="#" data-page="${p}" class="${page===p?'on':''}">${t}</a>`).join('');let html='';
if(page==='home'){html=`<section class="hero"><h1>We’re here to help resolve it.</h1><p>Submit a concern, follow its progress, and hear back from the resolution team.</p>${db.features.submit?'<button class="btn teal" data-page="new">Post a Complaint</button>':''} ${db.features.tracking?'<button class="btn" data-page="user">Track a Complaint</button>':''}</section>`;if(db.features.faq)html+=`<section class="panel"><h2>Common questions</h2><div class="grid">${db.faqs.map(x=>`<article class="card"><h3>${esc(x.q)}</h3><p>${esc(x.a)}</p></article>`).join('')}</div></section>`;html+=`<section class="panel"><h2>How it works</h2><div class="grid"><article class="card"><h3>1. Submit</h3><p>Choose a category, describe the issue, and optionally add a location.</p></article><article class="card"><h3>2. Track</h3><p>Check your complaint status and read updates from the assigned officer.</p></article><article class="card"><h3>3. Give feedback</h3><p>Share your feedback after the complaint is resolved.</p></article></div></section>`}
if(page==='login')html=form('Login','login',`<label>Login as</label><select name="role"><option value="user">User</option><option value="officer">Officer</option><option value="admin">Administrator</option></select>`+inp('email','Email','email')+inp('password','Password','password'),`<p class="muted">New user or officer? <a href="#" data-page="register">Register here</a><br>Demo accounts: admin@complainease.demo / admin123 · user@demo.com / user123 · officer@demo.com / officer123</p>`);
if(page==='register')html=form('Create an account','register',inp('name','Full name')+inp('email','Email','email')+inp('phone','Phone','tel')+`<label>Account type</label><select name="role"><option value="user">User</option><option value="officer">Officer</option></select>`+inp('password','Password (minimum 6 characters)','password','minlength="6" required'),`<p class="muted">Already registered? <a href="#" data-page="login">Login</a></p>`);
if(page==='contact')html=`<section class="panel"><h2>Administrator Contact</h2><p><b>${esc(db.contact.name)}</b></p><p>Email: <a href="mailto:${esc(db.contact.email)}">${esc(db.contact.email)}</a></p><p>Phone: ${esc(db.contact.phone)}</p></section>`;
if(page==='new'){let u=me();html=u?.role==='user'&&db.features.submit?form('Post a Complaint','newcomplaint',inp('title','Complaint title')+`<label>Category</label><select name="category"><option>Public services</option><option>Roads and transport</option><option>Utilities</option><option>Safety</option><option>Customer service</option><option>Other</option></select><label>Description</label><textarea name="description" rows="5" required></textarea><h3 style="margin-top:12px">Optional location</h3>${inp('location','Address / place name','text','') }<div class="grid"><div>${inp('lat','Latitude','number','step="any"')}</div><div>${inp('lng','Longitude','number','step="any"')}</div></div><p class="muted">Add coordinates to mark the location on Google Maps.</p><label>Supporting document / evidence reference (optional)</label><input name="evidence" type="text" placeholder="File name or short reference"><button class="btn">Submit Complaint</button>`):'<section class="panel"><h2>Sign in to post a complaint</h2><button class="btn" data-page="login">Login</button></section>'}
if(page==='user'){let u=me();if(u?.role!=='user')page='login';else html=`<section class="panel"><h2>My Complaints</h2><p class="muted">Status updates appear here. Email and SMS are simulated in this demo.</p><div class="grid">${db.complaints.filter(c=>c.email===u.email).map(c=>`<article class="card"><h3>${esc(c.title)}</h3><span class="tag">${esc(c.category)}</span> <span class="status">${esc(c.status)}</span><p>${esc(c.description)}</p><p class="muted">ID ${c.id} · Submitted ${esc(c.created)}</p>${c.location?`<p>Location: ${esc(c.location)} <a href="${mapLink(c)}" target="_blank" rel="noopener">Open map</a></p>`:''}${c.evidence?`<p>Evidence: ${esc(c.evidence)}</p>`:''}${c.updates.map(x=>`<p class="muted"><b>${esc(x.status||'Update')}:</b> ${esc(x.text)} ${x.proof?' · Proof: '+esc(x.proof):''}</p>`).join('')}${c.feedback?`<p><b>Your feedback:</b> ${esc(c.feedback)}</p>`:''}<form data-evidence="${c.id}"><label>Add information / evidence reference</label><input name="info" placeholder="Additional details"><button class="btn small">Add information</button></form>${c.status==='Resolved'&&!c.feedback?`<form data-feedback="${c.id}"><label>Feedback</label><textarea name="feedback" rows="2" required></textarea><button class="btn teal small">Send feedback</button></form>`:''}</article>`).join('')||'<p>No complaints submitted yet.</p>'}</div></section>`}
if(page==='officer'){if(me()?.role!=='officer')page='login';else html=`<section class="panel"><h2>Officer Desk</h2><div class="scroll"><table><tr><th>Complaint</th><th>User</th><th>Details / location</th><th>Status & update</th></tr>${db.complaints.map(c=>`<tr><td>${c.id}<br><b>${esc(c.title)}</b><br><span class="tag">${esc(c.category)}</span></td><td>${esc(c.name)}<br>${esc(c.email)}<br>${esc(c.phone)}</td><td>${esc(c.description)}${c.location?`<br>${esc(c.location)} <a target="_blank" rel="noopener" href="${mapLink(c)}">Map</a>`:''}${c.evidence?`<br>Evidence: ${esc(c.evidence)}`:''}</td><td><span class="status">${esc(c.status)}</span><form data-officer="${c.id}"><label>Update status</label><select name="status">${['Submitted','Under Review','Information Needed','In Progress','Resolved','Rejected'].map(s=>`<option ${s===c.status?'selected':''}>${s}</option>`).join('')}</select><label>Update note</label><input name="note" placeholder="Message for user" required><label>Proof of work reference</label><input name="proof" placeholder="Document / work reference"><button class="btn small">Save update</button></form></td></tr>`).join('')||'<tr><td colspan="4">No complaints to review.</td></tr>'}</table></div></section>`}
if(page==='admin'&&me()?.role==='admin'){html=`<section class="panel"><h2>Administrator Dashboard</h2><div class="tabs"><button data-tab="complaints" class="${tab==='complaints'?'on':''}">Complaints</button><button data-tab="accounts" class="${tab==='accounts'?'on':''}">Accounts</button><button data-tab="features" class="${tab==='features'?'on':''}">Features & info</button></div>`;
if(tab==='complaints')html+=`<div class="scroll"><table><tr><th>ID / Title</th><th>User</th><th>Category</th><th>Status</th><th>Officer</th><th></th></tr>${db.complaints.map(c=>`<tr><td>${c.id}<br>${esc(c.title)}</td><td>${esc(c.name)}<br>${esc(c.email)}<br>${esc(c.phone)}</td><td>${esc(c.category)}</td><td>${esc(c.status)}</td><td>${esc(c.officer||'Unassigned')}</td><td><button class="btn red small" data-action="deletecomplaint" data-id="${c.id}">Delete</button></td></tr>`).join('')||'<tr><td colspan="6">No complaints yet.</td></tr>'}</table></div>`;
if(tab==='accounts')html+=`<h3>Create officer account</h3><form id="createofficer" class="grid">${inp('name','Officer name')}${inp('email','Email','email')}${inp('phone','Phone','tel')}${inp('password','Initial password','password','minlength="6" required')}<button class="btn">Create officer</button></form><h3 style="margin-top:14px">All accounts</h3><div class="scroll"><table><tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Actions</th></tr>${db.users.map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.email)}</td><td>${esc(x.phone)}</td><td>${x.role}</td><td><button class="btn small" data-action="password" data-id="${encodeURIComponent(x.email)}">Change password</button>${x.role!=='admin'?`<button class="btn red small" data-action="deleteuser" data-id="${encodeURIComponent(x.email)}">Delete</button>`:''}</td></tr>`).join('')}</table></div>`;
if(tab==='features')html+=`<h3>Show or hide user-facing features</h3><form id="features">${Object.entries({submit:'Post complaint',tracking:'Complaint tracking',feedback:'Feedback',faq:'Common questions'}).map(([k,v])=>`<label><input type="checkbox" name="${k}" ${db.features[k]?'checked':''} style="width:auto"> ${v}</label>`).join('')}<button class="btn">Save features</button></form><h3 style="margin-top:16px">Support contact information</h3><form id="contact">${inp('name','Display name','text',`value="${esc(db.contact.name)}" required`)}${inp('email','Support email','email',`value="${esc(db.contact.email)}" required`)}${inp('phone','Phone','text',`value="${esc(db.contact.phone)}" required`)}<button class="btn">Save contact</button></form>`;html+='</section>'}
document.querySelector('#app').innerHTML=html||''}
document.addEventListener('click',e=>{let p=e.target.closest('[data-page]'),t=e.target.closest('[data-tab]'),a=e.target.closest('[data-action]');if(p){e.preventDefault();go(p.dataset.page);return}if(t){tab=t.dataset.tab;render();return}if(!a)return;let email=decodeURIComponent(a.dataset.id||'');if(a.dataset.action==='logout'){sessionStorage.removeItem(UK);go('home')}if(a.dataset.action==='deletecomplaint'){db.complaints=db.complaints.filter(c=>c.id!==a.dataset.id);save();render()}if(a.dataset.action==='deleteuser'){if(email===me()?.email){toast('You cannot delete the signed-in admin account.',true);return}db.users=db.users.filter(x=>x.email!==email);save();render()}if(a.dataset.action==='password'){let x=db.users.find(x=>x.email===email),pw=prompt('Enter a new password (minimum 6 characters):');if(pw===null)return;if(pw.length<6)return toast('Password must be at least 6 characters.',true);x.password=pw;save();toast('Password changed.')}});
document.addEventListener('submit',e=>{e.preventDefault();let f=e.target,d=new FormData(f),u=me(),today=new Date().toLocaleDateString();if(f.id==='register'){let email=String(d.get('email')).trim().toLowerCase();if(db.users.some(x=>x.email===email))return toast('Email already registered.',true);db.users.push({name:String(d.get('name')).trim(),email,phone:String(d.get('phone')).trim(),password:d.get('password'),role:String(d.get('role'))});save();toast('Account created. Please login.');go('login')}if(f.id==='login'){let x=db.users.find(z=>z.email===String(d.get('email')).trim().toLowerCase());if(!x||x.password!==d.get('password'))return toast('Email or password is incorrect.',true);if(x.role!==d.get('role'))return toast('Choose the correct account type.',true);sessionStorage.setItem(UK,x.email);go(x.role==='admin'?'admin':x.role==='officer'?'officer':'user')}if(f.id==='newcomplaint'){let c={id:'CE'+String(db.next++),email:u.email,name:u.name,phone:u.phone,title:String(d.get('title')).trim(),category:String(d.get('category')),description:String(d.get('description')).trim(),location:String(d.get('location')||'').trim(),lat:String(d.get('lat')||''),lng:String(d.get('lng')||''),evidence:String(d.get('evidence')||'').trim(),status:'Submitted',created:today,officer:'',updates:[{status:'Submitted',text:'Your complaint was received.',proof:''}],feedback:''};db.complaints.unshift(c);save();toast('Complaint submitted. ID: '+c.id);go('user')}if(f.dataset.officer){let c=db.complaints.find(x=>x.id===f.dataset.officer);c.status=String(d.get('status'));c.officer=u.name;c.updates.push({status:c.status,text:String(d.get('note')).trim(),proof:String(d.get('proof')||'').trim()});save();toast('Complaint status updated.');render()}if(f.dataset.feedback){let c=db.complaints.find(x=>x.id===f.dataset.feedback);c.feedback=String(d.get('feedback')).trim();save();toast('Feedback submitted.');render()}if(f.dataset.evidence){let c=db.complaints.find(x=>x.id===f.dataset.evidence);c.updates.push({status:'Additional information',text:String(d.get('info')).trim(),proof:''});save();toast('Information added.');render()}if(f.id==='createofficer'){let email=String(d.get('email')).trim().toLowerCase();if(db.users.some(x=>x.email===email))return toast('Email already exists.',true);db.users.push({name:String(d.get('name')),email,phone:String(d.get('phone')),password:d.get('password'),role:'officer'});save();toast('Officer account created.');render()}if(f.id==='features'){Object.keys(db.features).forEach(k=>db.features[k]=d.has(k));save();toast('Feature settings saved.');render()}if(f.id==='contact'){db.contact={name:String(d.get('name')),email:String(d.get('email')),phone:String(d.get('phone'))};save();toast('Contact information saved.');render()}});save();render();
</script></body></html>
