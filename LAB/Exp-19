            {name:"Heat Stress",animal:"Cattle, goats and pets",symptoms:"Rapid breathing, weakness and reduced appetite.",prescription:"Provide shade, clean water and ventilation. Seek urgent veterinary help if severe.",image:""},
            {name:"Worm Infestation",animal:"Livestock and pets",symptoms:"Weight loss, poor growth and digestive problems.",prescription:"Ask a veterinarian about appropriate parasite testing and deworming.",image:""}
        ]);
    }
    if(!localStorage.getItem("vcNews")){
        save("vcNews",[
            {title:"Animal Vaccination Awareness",body:"Keep animal vaccinations up to date with guidance from a qualified veterinarian."},
            {title:"Summer Care for Livestock",body:"Provide shade, adequate drinking water and good ventilation during hot weather."},
            {title:"Maintain Clean Animal Shelters",body:"Clean shelters and feeding areas regularly to support animal health."}
        ]);
    }
    ["vcComplaints","vcFeedback","vcPayments"].forEach(k=>{
        if(!localStorage.getItem(k))save(k,[]);
    });
}
