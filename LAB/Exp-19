        <div class="field full"><label>Symptoms</label><textarea name="symptoms" required></textarea></div>
        <div class="field full"><label>General Care Information</label><textarea name="prescription" required></textarea></div>
        </div><button class="btn">Add Disease Information</button></form>
        <div class="grid">${diseaseCardsHTML()}</div>`;
    }
    else if(page==="Manage News"&&doctor){
        html=`<h2>Manage News</h2><form class="form-card" style="max-width:none;margin:0 0 20px" onsubmit="addNews(event)">
        <div class="field"><label>News Title</label><input name="title" required></div>
        <div class="field"><label>News Content</label><textarea name="body" required></textarea></div>
        <button class="btn">Publish News</button></form><div class="grid">${newsCards(true)}</div>`;
    }
    else if(page==="View User Details"&&doctor){
