function chooseDoctor(doctorId){
    const u=currentUser();
    if(!u){showLogin();return;}
    if(u.role!=="farmer")return message("Only farmer accounts can submit complaints.");
    dashboardPage("Post Complaint");
    setTimeout(()=>{
        const select=document.querySelector('[name="doctorId"]');
