function reportHTML(){
    const complaints=read("vcComplaints");
    if(!complaints.length)return "<p>No complaint records available yet. Reports will appear after complaints are submitted.</p>";
    const counts={};
    complaints.forEach(c=>counts[c.animal]=(counts[c.animal]||0)+1);
    const max=Math.max(...Object.values(counts),1);
    return `<div class="card"><h3>Complaints by Animal Type</h3>${Object.entries(counts).map(([name,count])=>`<p>${escapeHTML(name)} — ${count}</p><div style="height:12px;background:#e6eee8;border-radius:8px;margin-bottom:12px"><div style="height:12px;width:${count/max*100}%;background:var(--green);border-radius:8px"></div></div>`).join("")}</div><div class="card" style="margin-top:15px"><h3>Total Recorded Complaints: ${complaints.length}</h3><p>These are browser-demo records, not verified regional disease statistics.</p></div>`;
}

