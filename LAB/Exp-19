function toggleDoctorFields(){
    const doctor=$("registerRole").value==="doctor";
    document.querySelectorAll(".doctor-field").forEach(el=>el.classList.toggle("hidden",!doctor));
}
function registerUser(e){
    e.preventDefault();
    const f=new FormData(e.target);
    const name=f.get("name").trim();
    const email=f.get("email").trim().toLowerCase();
    const password=f.get("password");
    if(password!==f.get("confirm"))return message("Passwords do not match.");
    let users=read("vcUsers");
    if(users.some(u=>u.email===email))return message("This email is already registered.");
    const user={
        id:id(),name,email,password,phone:f.get("phone"),
        role:f.get("role"),address:f.get("address")
    };
    if(user.role==="doctor"){
        Object.assign(user,{
            speciality:f.get("speciality"),clinic:f.get("clinic"),
            fee:Number(f.get("fee")||0),bank:f.get("bank"),
            easypaisa:f.get("easypaisa")
        });
    }
    users.push(user);save("vcUsers",users);
    message("Registration successful. Please log in.");
    showLogin();
}
function showLogin(){
