        <div class="field full"><label>Upload Image (optional)</label><input type="file" name="image" accept="image/*" onchange="previewFile(this,'imagePreview')"><div id="imagePreview"></div></div>
        <div class="field"><label>Upload Audio (optional)</label><input type="file" name="audio" accept="audio/*"></div>
        <div class="field"><label>Upload Video (optional)</label><input type="file" name="video" accept="video/*"></div>
        </div><button class="btn">Submit Complaint</button></form></div>`;
    }
    else if(page==="My Complaint Status"&&!doctor){
        html=`<h2>My Complaint Status</h2>${complaintTable(mine,false)}`;
    }
