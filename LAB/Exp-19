}
function diseaseCardsHTML(){
    return read("vcDiseases").map((d,i)=>`<div class="card"><h3>${escapeHTML(d.name)}</h3><p><b>Animals:</b> ${escapeHTML(d.animal)}</p><p><b>Symptoms:</b> ${escapeHTML(d.symptoms)}</p><p><b>Care:</b> ${escapeHTML(d.prescription)}</p><button class="btn btn-danger" onclick="deleteDisease(${i})">Delete</button></div>`).join("");
