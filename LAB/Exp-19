    else if(page==="View Payment Details"&&doctor){
        html=`<h2>Payment Details</h2>${paymentTable(read("vcPayments"))}<h3>My Payment Account Information</h3><div class="card"><p><b>Bank:</b> ${escapeHTML(u.bank||"Not provided")}</p><p><b>EasyPaisa:</b> ${escapeHTML(u.easypaisa||"Not provided")}</p></div>`;
    }
    else if(page==="Feedback Details"&&doctor){
        const fb=read("vcFeedback");
        html=`<h2>Farmer Feedback</h2>${fb.length?`<div class="grid">${fb.map(f=>`<div class="card"><h3>${escapeHTML(f.userName)}</h3><p>${escapeHTML(f.rating)}</p><p>${escapeHTML(f.text)}</p></div>`).join("")}</div>`:"<p>No feedback received yet.</p>"}`;
    }
    else if(page==="My Profile"){
        html=`<h2>My Profile</h2><form class="form-card" style="max-width:none;margin:0" onsubmit="updateProfile(event)">
        <div class="form-grid">
        <div class="field"><label>Full Name</label><input name="name" required value="${escapeHTML(u.name)}"></div>
        <div class="field"><label>Phone</label><input name="phone" value="${escapeHTML(u.phone||"")}"></div>
        <div class="field full"><label>Email</label><input value="${escapeHTML(u.email)}" disabled></div>
        <div class="field full"><label>Address / Clinic Address</label><textarea name="address">${escapeHTML(u.address||"")}</textarea></div>
        ${doctor?`<div class="field"><label>Speciality</label><input name="speciality" value="${escapeHTML(u.speciality||"")}"></div>
        <div class="field"><label>Clinic Type</label><select name="clinic"><option ${u.clinic==="Government CVH"?"selected":""}>Government CVH</option><option ${u.clinic==="Private Clinic"?"selected":""}>Private Clinic</option></select></div>
        <div class="field"><label>Consultation Fee (₹)</label><input name="fee" type="number" min="0" value="${Number(u.fee||0)}"></div>
        <div class="field"><label>Bank Details</label><input name="bank" value="${escapeHTML(u.bank||"")}"></div>
        <div class="field full"><label>EasyPaisa Account</label><input name="easypaisa" value="${escapeHTML(u.easypaisa||"")}"></div>`:""}
        </div><button class="btn">Update Profile</button></form>`;
    }
    else{
        html=`<h2>${escapeHTML(page)}</h2><p>This section is available for the relevant account type.</p>`;
    }
    $("dashContent").innerHTML=html;
}

function previewFile(input,target){
    const file=input.files[0];
    if(!file)return;
    if(file.size>3*1024*1024){
        message("For this browser demo, choose a file smaller than 3 MB.");
        input.value="";
        return;
    }
    if(file.type.startsWith("image/")){
        const reader=new FileReader();
        reader.onload=()=>$(target).innerHTML=`<img src="${reader.result}" alt="Selected animal" style="max-width:150px;max-height:120px;margin-top:10px;border-radius:8px">`;
        reader.readAsDataURL(file);
    }
}
function submitComplaint(e){
    e.preventDefault();
    const u=requireUser();if(!u)return;
    const f=new FormData(e.target);
    const image=e.target.elements.image.files[0];
    const audio=e.target.elements.audio.files[0];
    const video=e.target.elements.video.files[0];
    if([image,audio,video].some(file=>file&&file.size>3*1024*1024)){
        return message("Each uploaded file must be under 3 MB in this demo.");
    }
    const complaint={
        id:id(),userId:u.id,userName:u.name,doctorId:f.get("doctorId"),
        animal:f.get("animal"),age:f.get("age"),location:f.get("location"),
        symptoms:f.get("symptoms"),status:"Pending",solution:"",
        date:new Date().toLocaleDateString(),imageName:image?.name||"",
        audioName:audio?.name||"",videoName:video?.name||""
    };
    const complaints=read("vcComplaints");complaints.push(complaint);save("vcComplaints",complaints);
    message("Complaint submitted successfully.");
    dashboardPage("My Complaint Status");
}
function complaintTable(list,doctor){
    if(!list.length)return "<p>No complaints found.</p>";
    return `<div class="table-wrap"><table><thead><tr><th>Animal</th><th>${doctor?"Farmer":"Symptoms"}</th><th>Date</th><th>Status</th><th>Files</th>${doctor?"<th>Action</th>":"<th>Doctor Response</th>"}</tr></thead><tbody>
    ${list.map(c=>`<tr><td>${escapeHTML(c.animal)}</td><td>${escapeHTML(doctor?c.userName:c.symptoms)}</td><td>${escapeHTML(c.date)}</td><td><span class="badge ${c.status==="Resolved"?"resolved":c.status==="In Progress"?"progress":"pending"}">${escapeHTML(c.status)}</span></td><td>${escapeHTML([c.imageName,c.audioName,c.videoName].filter(Boolean).join(", ")||"None")}</td><td>${doctor?`<button class="btn btn-green" onclick="respondToComplaint('${c.id}')">Respond</button>`:escapeHTML(c.solution||"Awaiting doctor response")}</td></tr>`).join("")}
    </tbody></table></div>`;
}
function respondToComplaint(complaintId){
    const c=read("vcComplaints").find(x=>x.id===complaintId);
    if(!c)return;
    const solution=prompt("Enter veterinary advice / solution:");
    if(!solution||!solution.trim())return;
    c.solution=solution.trim();
    c.status="In Progress";
    const status=confirm("Mark this complaint as Resolved? Click Cancel to keep In Progress.");
    if(status)c.status="Resolved";
    save("vcComplaints",read("vcComplaints").map(x=>x.id===c.id?c:x));
    dashboardPage("View Complaint");
}
function postSolution(e){
    e.preventDefault();
    const f=new FormData(e.target);
    const complaints=read("vcComplaints");
    const c=complaints.find(x=>x.id===f.get("complaintId"));
    if(!c)return message("No complaint selected.");
    c.solution=f.get("solution");c.status=f.get("status");
    save("vcComplaints",complaints);
    message("Solution submitted.");
    dashboardPage("View Complaint");
}
function updateProfile(e){
    e.preventDefault();
    const u=requireUser();if(!u)return;
    const f=new FormData(e.target);
    const users=read("vcUsers");
    const index=users.findIndex(x=>x.id===u.id);
    if(index<0)return;
    users[index]={...users[index],name:f.get("name"),phone:f.get("phone"),address:f.get("address")};
    if(u.role==="doctor"){
        Object.assign(users[index],{
            speciality:f.get("speciality"),clinic:f.get("clinic"),
            fee:Number(f.get("fee")||0),bank:f.get("bank"),easypaisa:f.get("easypaisa")
        });
    }
    save("vcUsers",users);setUser(users[index]);
    message("Profile updated successfully.");dashboardPage("My Profile");
}
function submitFeedback(e){
    e.preventDefault();
    const u=requireUser();if(!u)return;
    const f=new FormData(e.target),items=read("vcFeedback");
    items.push({id:id(),userId:u.id,userName:u.name,rating:f.get("rating"),text:f.get("text"),date:new Date().toLocaleDateString()});
    save("vcFeedback",items);message("Feedback submitted.");dashboardPage();
}
function showDoctorPayment(doctorId){
    const d=read("vcUsers").find(x=>x.id===doctorId);
    $("doctorPayment").innerHTML=!d?"Select a doctor.":`<b>${escapeHTML(d.name)}</b><br>Clinic: ${escapeHTML(d.clinic||"Not specified")}<br>Consultation Fee: ₹${Number(d.clinic==="Government CVH"?0:d.fee||0)}<br>Bank Details: ${escapeHTML(d.bank||"Ask the doctor")}<br>EasyPaisa: ${escapeHTML(d.easypaisa||"Ask the doctor")}`;
}
function makePayment(e){
    e.preventDefault();
    const u=requireUser();if(!u)return;
    const f=new FormData(e.target),d=read("vcUsers").find(x=>x.id===f.get("doctorId"));
    if(!d)return message("Please select a doctor.");
    const amount=d.clinic==="Government CVH"?0:Number(d.fee||0);
    const payments=read("vcPayments");
    payments.push({id:id(),userId:u.id,userName:u.name,doctorId:d.id,doctorName:d.name,amount,method:f.get("method"),status:amount===0?"Free service — demo":"Demo payment recorded",date:new Date().toLocaleDateString()});
    save("vcPayments",payments);
    message("Demo payment record created. No real money was transferred.");
    dashboardPage("Make Payment");
}
function paymentTable(list){
    if(!list.length)return "<p>No payment records found.</p>";
    return `<div class="table-wrap"><table><thead><tr><th>User</th><th>Doctor</th><th>Amount</th><th>Method</th><th>Status</th><th>Date</th></tr></thead><tbody>${list.map(p=>`<tr><td>${escapeHTML(p.userName)}</td><td>${escapeHTML(p.doctorName)}</td><td>₹${Number(p.amount)}</td><td>${escapeHTML(p.method)}</td><td>${escapeHTML(p.status)}</td><td>${escapeHTML(p.date)}</td></tr>`).join("")}</tbody></table></div>`;
