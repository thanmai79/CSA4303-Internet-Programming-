            <button class="btn" type="submit">Login</button>
        </form>
        <hr><p class="small">Demo Farmer: farmer@gmail.com / farmer123</p>
        <p class="small">Demo Doctor: doctor@gmail.com / doctor123</p>
        <p>New to VETCURE? <a href="#" onclick="showRegister();return false">Register here</a></p>
    </div>`;
}
function loginUser(e){
    e.preventDefault();
    const f=new FormData(e.target);
    const email=f.get("email").trim().toLowerCase();
    const user=read("vcUsers").find(u=>u.email===email&&u.password===f.get("password")&&u.role===f.get("role"));
    if(!user)return message("Invalid email, password or account type.");
    setUser(user);
    showDashboard();
}
function requireUser(){
    const u=currentUser();
    if(!u){message("Please log in first.");showLogin();return null;}
    return u;
}

function showDashboard(page="Dashboard"){
    const u=currentUser();
    if(!u){showLogin();return;}
    const doctor=u.role==="doctor";
    const items=doctor?
    ["Dashboard","View Complaint","Post Solution","Manage Cure","Manage News","View User Details","View Payment Details","Feedback Details","My Profile","Logout"]:
    ["Dashboard","Post Complaint","My Complaint Status","View Vetcure Details","View News","View Doctor","View Report","Post Feedback","Make Payment","My Profile","Logout"];
    $("app").innerHTML=`
    <div class="layout">
        <aside class="sidebar">
            <h3>🐾 VETCURE</h3>
            <p class="small">${doctor?"Doctor Panel":"Farmer Panel"}</p>
            ${items.map(item=>`<button onclick="dashboardPage('${item}')" class="${item===page?'active':''}">${item}</button>`).join("")}
        </aside>
        <div class="dashboard-content" id="dashContent"></div>
    </div>`;
    dashboardPage(page);
}
