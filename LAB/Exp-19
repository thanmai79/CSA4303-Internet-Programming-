        <div class="form-grid">
        <div class="field"><label>Animal Type</label><select name="animal" required><option>Cow</option><option>Buffalo</option><option>Goat</option><option>Sheep</option><option>Dog</option><option>Cat</option><option>Other</option></select></div>
