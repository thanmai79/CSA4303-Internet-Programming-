function usersTable(list){
    if(!list.length)return "<p>No users registered yet.</p>";
    return `<div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Address</th></tr></thead><tbody>${list.map(u=>`<tr><td>${escapeHTML(u.name)}</td><td>${escapeHTML(u.email)}</td><td>${escapeHTML(u.phone||"")}</td><td>${escapeHTML(u.address||"")}</td></tr>`).join("")}</tbody></table></div>`;
}
function addDisease(e){
